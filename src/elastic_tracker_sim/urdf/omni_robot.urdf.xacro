<?xml version="1.0"?>
<robot name="omni_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="gray"><color rgba="0.4 0.4 0.4 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.9 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>

  <xacro:property name="body_len" value="0.3"/>
  <xacro:property name="body_wid" value="0.25"/>
  <xacro:property name="body_hgt" value="0.12"/>
  <xacro:property name="wheel_rad" value="0.04"/>
  <xacro:property name="wheel_len" value="0.02"/>
  <xacro:property name="wheel_x" value="0.13"/>
  <xacro:property name="wheel_y" value="0.15"/>
  <xacro:property name="wheel_z" value="-0.04"/>

  <!-- Base Footprint (for nav2) -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry><box size="${body_len} ${body_wid} ${body_hgt}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="${body_len} ${body_wid} ${body_hgt}"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.02" iyy="0.03" izz="0.03" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- 4 Mecanum Wheels -->
  <xacro:macro name="wheel" params="name x y">
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="1.57 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="20"/>
    </joint>
    <link name="${name}_wheel_link">
      <visual><geometry><cylinder radius="${wheel_rad}" length="${wheel_len}"/></geometry><material name="dark"/></visual>
      <collision><geometry><cylinder radius="${wheel_rad}" length="${wheel_len}"/></geometry></collision>
      <inertial><mass value="0.05"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
  </xacro:macro>

  <xacro:wheel name="fl" x="${wheel_x}"  y="${wheel_y}"/>
  <xacro:wheel name="fr" x="${wheel_x}"  y="${-wheel_y}"/>
  <xacro:wheel name="rl" x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="rr" x="${-wheel_x}" y="${-wheel_y}"/>

  <!-- Lidar -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.08 0 0.10" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="white"/></visual>
    <collision><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- ══════════════════ GAZEBO ══════════════════ -->
  <gazebo>
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros><remapping>/odom:=odom</remapping></ros>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_tf>true</publish_tf>
      <broadcast_tf>true</broadcast_tf>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- Lidar sensor -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
        </scan>
        <range><min>0.1</min><max>12.0</max><resolution>0.01</resolution></range>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
</robot>
