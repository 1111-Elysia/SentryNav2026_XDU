<root main_tree_to_execute="PatrolTree">
    <BehaviorTree ID="PatrolTree">
        <Sequence>
            <InitPoints points_param="points"/>

            <Repeat num_cycles="-1">
                <Sequence>
                    
                    <NextPoint goal="{goal}"/>

                    <Parallel success_threshold="1" failure_threshold="1">
                        
                        <SendNav2Goal goal="{goal}"/>

                        <CheckDistance goal="{goal}" threshold="0.6"/>
                        
                    </Parallel>
                    
                </Sequence>
            </Repeat>
        </Sequence>
    </BehaviorTree>

    <TreeNodesModel>
       
        <Action ID="InitPoints">
            <input_port name="points_param"/>
        </Action>
        
        <Action ID="NextPoint">
            <output_port name="goal"/>
        </Action>
        
        <Action ID="SendNav2Goal">
            <input_port name="goal"/>
        </Action>
        
        <Condition ID="CheckDistance">
            <input_port name="goal"/>
            <input_port name="threshold"/>
        </Condition>
    </TreeNodesModel>
    </root>