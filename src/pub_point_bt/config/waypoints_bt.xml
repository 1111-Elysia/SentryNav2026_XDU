<root main_tree_to_execute="PatrolTree">
    <BehaviorTree ID="PatrolTree">
        <Sequence>
            <PublishInitialPose x="0.0" y="0.0" yaw_deg="0.0" />

            <InitPoints points_param="points"/>

            <Repeat num_cycles="-1">
                <Sequence>
                    
                    <NextPoint goal="{goal}"/>

                    <Parallel success_threshold="1" failure_threshold="1">
                        
                        <SendNav2Goal goal="{goal}"/>

                        <CheckDistance goal="{goal}" threshold="0.6"/>
                        
                    </Parallel>
                    
                    </Sequence>
            </Repeat>
        </Sequence>
    </BehaviorTree>
</root>