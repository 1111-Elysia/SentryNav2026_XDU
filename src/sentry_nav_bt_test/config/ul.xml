<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="Root">
      <KeepRunningUntilFailure>
        <Sequence name="裁判系统连接判定">
          <Inverter>
            <CheckCondition key_name="game_status_received"
                            comparison="eq"
                            threshold="1.0"/>
          </Inverter>
        </Sequence>
      </KeepRunningUntilFailure>
      <ForceFailure>
        <PrintNode message="裁判系统连接成功"/>
      </ForceFailure>
      <KeepRunningUntilFailure>
        <Sequence name="开始比赛检测">
          <CheckCondition key_name="game_progress"
                          comparison="lte"
                          threshold="3.0"/>
        </Sequence>
      </KeepRunningUntilFailure>

      <ForceFailure>
        <Fallback name="初始化">
          <CheckCondition key_name="ul_initialized"
                          comparison="eq"
                          threshold="1.0"/>
          <Sequence name="初始化状态">
            <PrintNode message="比赛开始，初始化黑板变量"/>
            <SetBlackboardValue key="aim_id"
                                value="0"
                                type="uint8"/>
            <SetBlackboardValue key="hurt_armor"
                                value="5"
                                type="uint8"/>
            <SetBlackboardValue key="ul_center_ready"
                                value="0"
                                type="int"/>
            <SetBlackboardValue key="ul_retreat_active"
                                value="0"
                                type="int"/>
            <SetBlackboardValue key="ul_initialized"
                                value="1"
                                type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>

      <ReactiveFallback name="比赛开始">
        <Sequence name="低血量回补">
          <Fallback name="回补触发或保持">
            <CheckCondition key_name="ul_retreat_active"
                            comparison="eq"
                            threshold="1.0"/>
            <Sequence name="触发回补模式">
              <CheckCondition name="低血量判定"
                              key_name="current_hp"
                              comparison="lt"
                              threshold="150.0"/>
              <PrintNode message="[UL] 血量低于150，触发回补模式"/>
              <SetBlackboardValue key="ul_retreat_active"
                                  value="1"
                                  type="int"/>
              <SetBlackboardValue key="ul_center_ready"
                                  value="0"
                                  type="int"/>
            </Sequence>
          </Fallback>
          <GoalSelector goal_name="supply_point"
                        goal="{goal}"/>
          <ReliableNavigateToPose goal="{goal}"
                                  goal_name="supply_point"
                                  reach_threshold="0.25"
                                  resend_interval="0.30"
                                  response_timeout="0.80"
                                  result_retry_delay="0.30"/>
          <Wait wait_duration="5.0"/>
          <KeepRunningUntilFailure>
            <Sequence name="等待回血完成">
              <Inverter>
                <CheckCondition name="回补结束判定"
                                key_name="current_hp"
                                comparison="gte"
                                threshold="390.0"/>
              </Inverter>
              <Wait wait_duration="0.2"/>
            </Sequence>
          </KeepRunningUntilFailure>
          <PrintNode message="[UL] 回补完成，准备重新前往中心"/>
          <SetBlackboardValue key="ul_retreat_active"
                              value="0"
                              type="int"/>
        </Sequence>

        <Sequence name="前往中心">
          <CheckCondition key_name="ul_retreat_active"
                          comparison="eq"
                          threshold="0.0"/>
          <CheckCondition key_name="ul_center_ready"
                          comparison="eq"
                          threshold="0.0"/>
          <GoalSelector goal_name="center_point"
                        goal="{goal}"/>
          <ReliableNavigateToPose goal="{goal}"
                                  goal_name="center_point"
                                  reach_threshold="0.25"
                                  resend_interval="0.30"
                                  response_timeout="0.80"
                                  result_retry_delay="0.30"/>
          <SetBlackboardValue key="ul_center_ready"
                              value="1"
                              type="int"/>
          <PrintNode message="[UL] 已到达中心区域，进入驻守态"/>
        </Sequence>

        <Sequence name="中心驻守">
          <CheckCondition key_name="ul_retreat_active"
                          comparison="eq"
                          threshold="0.0"/>
          <CheckCondition key_name="ul_center_ready"
                          comparison="eq"
                          threshold="1.0"/>
          <CheckCondition key_name="current_hp"
                          comparison="gte"
                          threshold="150.0"/>
          <GoalSelector goal_name="center_point"
                        goal="{goal}"/>
          <Fallback name="中心位置维持">
            <Sequence name="已在中心附近">
              <CheckGoalReached goal="{goal}"
                                threshold="0.50"/>
              <Wait wait_duration="0.5"/>
            </Sequence>
            <ReliableNavigateToPose goal="{goal}"
                                    goal_name="center_point_hold"
                                    reach_threshold="0.50"
                                    resend_interval="0.50"
                                    response_timeout="1.00"
                                    result_retry_delay="0.50"/>
          </Fallback>
        </Sequence>
      </ReactiveFallback>
    </Fallback>
  </BehaviorTree>

  <!-- =========================
       TreeNodesModel
       ========================= -->
  <TreeNodesModel>

    <Condition ID="CheckCondition" editable="true">
      <input_port name="key_name"/>
      <input_port name="comparison"/>
      <input_port name="threshold"/>
    </Condition>

    <Action ID="GoalSelector" editable="true">
      <input_port name="goal_name"/>
      <output_port name="goal"/>
    </Action>

    <Action ID="PatrolGoalSelector" editable="true">
      <input_port name="goal_names"/>
      <input_port name="index_key"/>
      <output_port name="goal"/>
      <output_port name="goal_name"/>
    </Action>

    <Action ID="NavigateToPose" editable="true">
      <input_port name="goal"/>
    </Action>

    <Action ID="ReliableNavigateToPose" editable="true">
      <input_port name="goal"/>
      <input_port name="goal_name"/>
      <input_port name="reach_threshold"/>
      <input_port name="resend_interval"/>
      <input_port name="response_timeout"/>
      <input_port name="result_retry_delay"/>
    </Action>

    <Condition ID="CheckGoalReached" editable="true">
      <input_port name="goal"/>
      <input_port name="threshold"/>
    </Condition>

    <Action ID="PrintBlackboardValue" editable="true">
      <input_port name="key"/>
      <input_port name="prefix"/>
    </Action>

    <Action ID="PrintNode" editable="true">
      <input_port name="message"/>
    </Action>

    <Action ID="SetBlackboardValue" editable="true">
      <input_port name="key"/>
      <input_port name="value"/>
      <input_port name="type"/>
    </Action>

    <Action ID="Wait" editable="true">
      <input_port name="wait_duration"/>
    </Action>

    <Decorator ID="RetryUntilSuccessful">
      <input_port name="num_attempts"/>
    </Decorator>
    <Decorator ID="KeepRunningUntilFailure"/>
    <Decorator ID="ForceSuccess"/>
    <Decorator ID="ForceFailure"/>
    <Decorator ID="Inverter"/>
    <Control ID="Parallel"/>

  </TreeNodesModel>
</root>
