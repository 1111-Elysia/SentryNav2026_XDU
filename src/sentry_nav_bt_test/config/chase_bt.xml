<root BTCPP_format="3" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Fallback name="ChaseOrFail">

      <!-- 追击分支：追到近距离算成功 -->
      <Sequence name="ChaseSequence">
        <ChaseTarget
          aim_topic="/autoaim/target_bl"  
          world_frame="map"
          base_frame="base_link"
          nav_action="navigate_to_pose"

          standoff="1.0"
          stop_dist="1.0"
          start_dist="1.6"

          lost_timeout="0.6"
          update_thresh="0.6"
          max_rate="3.0"

          ema_alpha="0.35"
          max_jump="2.5"

          chase_status="{chase_status}"
          last_goal="{last_goal}"
        />
      </Sequence>

      <!-- 丢失目标/异常 -->
      <Sequence name="LostOrError">
        <AlwaysFailure/>
      </Sequence>

    </Fallback>
  </BehaviorTree>

</root>