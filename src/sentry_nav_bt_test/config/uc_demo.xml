<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Global_Loop">
      
      <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
      <CheckCondition key_name="game_progress" comparison="eq" threshold="4"/>

      <ReactiveFallback name="Root_Logic">
      
          <Sequence name="Survival_Logic">
             <CheckCondition key_name="is_under_attack" comparison="eq" threshold="1"/>
             <CheckCondition key_name="current_hp" comparison="lt" threshold="200"/>
             
             <PrintNode message="!!! 触发生存模式: 撤退回补给区 !!!"/>
             <ForceSuccess><Action ID="SetSentryPosture" mode="2"/></ForceSuccess>
             
             <GoalSelector goal_name="supply_point" goal="{goal}"/>
             <NavigateToPose goal="{goal}"/>
             
             <PrintNode message="到达补给区，等待回血..."/>
             <SetBlackboardValue key="vw" value="0.0" type="float"/>
             <Wait wait_duration="5.0"/>
             <SetBlackboardValue key="is_under_attack" value="0" type="int"/>
          </Sequence>

          <Sequence name="Combat_Logic">
             <CheckCondition key_name="is_under_attack" comparison="eq" threshold="1"/>
             
             <PrintNode message="!!! 遭遇敌人: 原地反击 !!!"/>
             <ForceSuccess><Action ID="SetSentryPosture" mode="1"/></ForceSuccess>
             <SetBlackboardValue key="vw" value="15.0" type="float"/>
             <Wait wait_duration="1.0"/>
             <SetBlackboardValue key="is_under_attack" value="0" type="int"/>
          </Sequence>

          <Fallback name="Timeline_Selector">

                <Sequence name="Phase_0_EndGame">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="60"/>
                    
                    <PrintNode message="[1:00~0:00] 死守基地模式"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="1"/></ForceSuccess>
                    
                    <GoalSelector goal_name="base_defense_point" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>
                    <Wait wait_duration="2.0"/>
                </Sequence>

                <Sequence name="Phase_1_BigRune_Conditional">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="90"/>
                    
                    <CheckCondition key_name="ally_base_hp" comparison="gt" threshold="2000"/>
                    <CheckCondition key_name="big_rune_status" comparison="eq" threshold="0"/>
                    <CheckCondition key_name="can_activate_rune" comparison="eq" threshold="1"/>
                    
                    <PrintNode message="[1:30~1:00] 基地健康，尝试激活最后的大符"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="3"/></ForceSuccess>
                    <GoalSelector goal_name="tunnel_rune_point" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>
                    
                    <RetryUntilSuccessful num_attempts="50">
                        <Fallback>
                            <CheckCondition key_name="large_rune_status" comparison="eq" threshold="2"/>
                            <Sequence>
                                <Action ID="RequestActivateRune" posture="3"/>
                                <Wait wait_duration="1.0"/>
                            </Sequence>
                        </Fallback>
                    </RetryUntilSuccessful>
                    <PrintNode message="激活成功，输出20秒..."/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="2"/></ForceSuccess>
                    <Wait wait_duration="20.0"/>
                </Sequence>

                <Sequence name="Phase_2_Fortress">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="135"/>
                    
                    <PrintNode message="[2:15~1:30] 堡垒支援模式"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="1"/></ForceSuccess>
                    <GoalSelector goal_name="fortress" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>
                    <Wait wait_duration="2.0"/>
                </Sequence>

                <Sequence name="Phase_3_BigRune_Standard">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="165"/>
                    <CheckCondition key_name="can_activate_rune" comparison="eq" threshold="1"/>
                    <CheckCondition key_name="big_rune_status" comparison="eq" threshold="0"/>

                    <PrintNode message="[2:45~2:15] 激活大能量机关"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="3"/></ForceSuccess>
                    <GoalSelector goal_name="tunnel_rune_point" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>

                    <RetryUntilSuccessful num_attempts="50">
                        <Fallback>
                            <CheckCondition key_name="large_rune_status" comparison="eq" threshold="2"/>
                            <Sequence>
                                <Action ID="RequestActivateRune" posture="3"/>
                                <Wait wait_duration="1.0"/>
                            </Sequence>
                        </Fallback>
                    </RetryUntilSuccessful>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="2"/></ForceSuccess>
                    <Wait wait_duration="20.0"/>
                </Sequence>

                <Sequence name="Phase_4_Fortress">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="210"/>
                    
                    <PrintNode message="[3:30~2:45] 堡垒支援模式"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="1"/></ForceSuccess>
                    <GoalSelector goal_name="fortress" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>
                    <Wait wait_duration="2.0"/>
                </Sequence>

                <Sequence name="Phase_5_BigRune_First">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="240"/>
                    <CheckCondition key_name="can_activate_rune" comparison="eq" threshold="1"/>
                    <CheckCondition key_name="big_rune_status" comparison="eq" threshold="0"/>

                    <PrintNode message="[4:00~3:30] 首次大符激活"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="3"/></ForceSuccess>
                    <GoalSelector goal_name="tunnel_rune_point" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>

                    <RetryUntilSuccessful num_attempts="50">
                        <Fallback>
                            <CheckCondition key_name="large_rune_status" comparison="eq" threshold="2"/>
                            <Sequence>
                                <Action ID="RequestActivateRune" posture="3"/>
                                <Wait wait_duration="1.0"/>
                            </Sequence>
                        </Fallback>
                    </RetryUntilSuccessful>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="2"/></ForceSuccess>
                    <Wait wait_duration="20.0"/>
                </Sequence>

                <Sequence name="Phase_6_MidGame_Decision">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="300"/>
                    
                    <PrintNode message="[5:00~4:00] 中期防守决策"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="2"/></ForceSuccess>
                    
                    <Fallback>
                        <Sequence>
                             <CheckCondition key_name="ally_outpost_hp" comparison="lt" threshold="100"/>
                             <PrintNode message=">>> 前哨站已毁，去堡垒"/>
                             <GoalSelector goal_name="fortress" goal="{goal}"/>
                             <NavigateToPose goal="{goal}"/>
                        </Sequence>
                        <Sequence>
                             <PrintNode message=">>> 前哨站存活，去公路"/>
                             <GoalSelector goal_name="highway_defense" goal="{goal}"/>
                             <NavigateToPose goal="{goal}"/>
                        </Sequence>
                    </Fallback>
                    <Wait wait_duration="2.0"/>
                </Sequence>

                <Sequence name="Phase_7_SmallRune_Second">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="330"/>
                    <CheckCondition key_name="can_activate_rune" comparison="eq" threshold="1"/>
                    <CheckCondition key_name="small_rune_status" comparison="eq" threshold="0"/>

                    <PrintNode message="[5:30~5:00] 第二次小符激活"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="3"/></ForceSuccess>
                    <GoalSelector goal_name="tunnel_rune_point" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>

                    <RetryUntilSuccessful num_attempts="50">
                        <Fallback>
                            <CheckCondition key_name="small_rune_status" comparison="eq" threshold="2"/>
                            <Sequence>
                                <Action ID="RequestActivateRune" posture="3"/>
                                <Wait wait_duration="1.0"/>
                            </Sequence>
                        </Fallback>
                    </RetryUntilSuccessful>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="2"/></ForceSuccess>
                    <Wait wait_duration="20.0"/>
                </Sequence>

                <Sequence name="Phase_8_Early_Defense">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="390"/>
                    
                    <PrintNode message="[6:30~5:30] 早期协助防守"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="2"/></ForceSuccess>
                    <GoalSelector goal_name="highway_defense" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>
                    <Wait wait_duration="2.0"/>
                </Sequence>

                <Sequence name="Phase_9_SmallRune_First">
                    <CheckCondition key_name="stage_remain_time" comparison="lte" threshold="420"/>
                    
                    <CheckCondition key_name="can_activate_rune" comparison="eq" threshold="1"/>
                    <CheckCondition key_name="small_rune_status" comparison="eq" threshold="0"/>
                    
                    <PrintNode message="[7:00~6:30] 开局抢小符"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="3"/></ForceSuccess>
                    <GoalSelector goal_name="tunnel_rune_point" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>

                    <RetryUntilSuccessful num_attempts="50">
                        <Fallback>
                            <CheckCondition key_name="small_rune_status" comparison="eq" threshold="2"/>
                            <Sequence>
                                <Action ID="RequestActivateRune" posture="3"/>
                                <Wait wait_duration="1.0"/>
                            </Sequence>
                        </Fallback>
                    </RetryUntilSuccessful>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="2"/></ForceSuccess>
                    <Wait wait_duration="20.0"/>
                </Sequence>

                <Sequence name="Phase_Default">
                    <PrintNode message="[Default] 默认巡逻/待机"/>
                    <ForceSuccess><Action ID="SetSentryPosture" mode="2"/></ForceSuccess>
                    <GoalSelector goal_name="highway_defense" goal="{goal}"/>
                    <NavigateToPose goal="{goal}"/>
                    <Wait wait_duration="2.0"/>
                </Sequence>

            </Fallback>

      </ReactiveFallback>
    </Sequence>
  </BehaviorTree>
  
  <TreeNodesModel>
      <Action ID="SetSentryPosture">
          <input_port name="mode" type="int">1:Attack, 2:Defend, 3:Move</input_port>
      </Action>
      <Action ID="RequestActivateRune">
          <input_port name="posture" type="int">3</input_port>
      </Action>
      <Action ID="CheckCondition">
          <input_port name="key_name"/>
          <input_port name="comparison"/>
          <input_port name="threshold"/>
      </Action>
      <Action ID="GoalSelector">
          <input_port name="goal_name"/>
          <output_port name="goal"/>
      </Action>
      <Action ID="NavigateToPose">
          <input_port name="goal"/>
      </Action>
      <Action ID="PrintNode">
          <input_port name="message"/>
      </Action>
      <Action ID="SetBlackboardValue">
          <input_port name="key"/>
          <input_port name="value"/>
          <input_port name="type"/>
      </Action>
      <Action ID="Wait">
          <input_port name="wait_duration"/>
      </Action>
      <Decorator ID="RetryUntilSuccessful">
          <input_port name="num_attempts"/>
      </Decorator>
      <Decorator ID="ForceSuccess"/>
  </TreeNodesModel>
</root>
