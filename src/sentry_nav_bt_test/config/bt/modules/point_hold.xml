<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="PointHold">
    <Sequence name="点位驻守">
      <SetBlackboardValue key="{rune_phase_key}" value="0" type="int"/>
      <SetBlackboardValue key="{fortress_active_key}" value="0" type="int"/>
      <GoalSelector goal_name="{point_hold_goal_name}" goal="{point_hold_goal}"/>
      <Fallback name="点位驻守维持">
        <ReactiveSequence name="已在驻守半径内">
          <CheckGoalReached goal="{point_hold_goal}" threshold="{point_hold_exit_threshold}"/>
          <ResolveSentryPosture
            requested_mode="{point_hold_posture}"
            resolved_mode="{point_hold_effective_posture}"/>
          <MaintainSentryPosture mode="{point_hold_effective_posture}"/>
          <Wait wait_duration="{point_hold_wait_duration}"/>
        </ReactiveSequence>
        <Sequence name="回驻守点位">
          <PrintNode message="{point_hold_message}" throttle_ms="{point_hold_log_throttle_ms}"/>
          <PublishControllerName controller_name="AdaptiveMppi"/>
          <RetryUntilSuccessful num_attempts="100">
            <ReactiveSequence name="回驻守点直到进入半径">
              <MaintainSentryPosture mode="{point_hold_move_posture}"/>
              <Sequence name="导航并检查到点">
                <ReliableNavigateToPose
                  goal="{point_hold_goal}"
                  goal_name="{point_hold_goal_name}"
                  reach_threshold="{point_hold_arrive_threshold}"
                  resend_interval="{nav_resend_interval}"
                  response_timeout="{nav_response_timeout}"
                  result_retry_delay="{nav_result_retry_delay}"/>
                <CheckGoalReached goal="{point_hold_goal}" threshold="{point_hold_exit_threshold}"/>
              </Sequence>
            </ReactiveSequence>
          </RetryUntilSuccessful>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>
