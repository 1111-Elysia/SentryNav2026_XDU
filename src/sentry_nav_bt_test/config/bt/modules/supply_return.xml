<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="SupplyReturn">
    <Sequence name="回补模式">
      <Fallback name="回补触发或保持">
        <CheckCondition key_name="{supply_active_key}" comparison="eq" threshold="1"/>
        <Sequence name="触发回补模式">
          <Fallback name="回补触发">
            <Inverter>
              <CheckCondition key_name="current_hp" comparison="gte" threshold="{supply_low_hp_threshold}"/>
            </Inverter>
            <Sequence>
              <CheckCondition key_name="current_hp" comparison="gte" threshold="{supply_low_hp_threshold}"/>
              <CheckCondition key_name="projectile_allowance_17mm" comparison="lte" threshold="{supply_low_ammo_threshold}"/>
            </Sequence>
          </Fallback>
          <SetBlackboardValue key="{supply_goal_index_key}" value="0" type="int"/>
          <SetBlackboardValue key="{supply_active_key}" value="1" type="int"/>
          <PrintNode message="{supply_start_message}"/>
        </Sequence>
      </Fallback>
      <SetBlackboardValue key="{rune_phase_key}" value="0" type="int"/>
      <SetBlackboardValue key="{fortress_active_key}" value="0" type="int"/>
      <Inverter>
        <KeepRunningUntilFailure>
          <Sequence name="回补_未补满时持续回补闭环">
            <Inverter>
              <Sequence name="回补已完成">
                <CompareValues first_key="current_hp" second_key="maximum_hp" comparison="gte"/>
                <CheckCondition key_name="projectile_allowance_17mm" comparison="gte" threshold="{supply_ready_ammo_threshold}"/>
              </Sequence>
            </Inverter>
            <ReactiveFallback name="回补_RFID保持或重发补给点">
              <Sequence name="回补_RFID在补给区内_原地等待恢复">
                <CheckCondition key_name="{supply_rfid_detected_key}" comparison="eq" threshold="1"/>
                <PrintNode message="[回补] 已读到补给区 RFID，保持防御姿态等待恢复" throttle_ms="2000"/>
                <MaintainSentryPosture mode="2"/>
                <Wait wait_duration="0.20"/>
              </Sequence>
              <Sequence name="回补_RFID丢失_两点往返找补给区">
                <PrintNode message="[回补] 未读到补给区 RFID，按两个补给点往返寻找" throttle_ms="2000"/>
                <MaintainSentryPosture mode="3"/>
                <PatrolGoalSelector
                  goal_names="{supply_goal_names}"
                  index_key="{supply_goal_index_key}"
                  goal="{supply_goal}"
                  goal_name="{supply_selected_goal_name}"/>
                <ReliableNavigateToPose
                  goal="{supply_goal}"
                  goal_name="{supply_selected_goal_name}"
                  reach_threshold="{supply_reach_threshold}"
                  resend_interval="{nav_resend_interval}"
                  response_timeout="{nav_response_timeout}"
                  result_retry_delay="{nav_result_retry_delay}"/>
                <Inverter>
                  <CheckCondition key_name="{supply_rfid_detected_key}" comparison="eq" threshold="1"/>
                </Inverter>
              </Sequence>
            </ReactiveFallback>
          </Sequence>
        </KeepRunningUntilFailure>
      </Inverter>
      <PrintNode message="{supply_done_message}"/>
      <SetBlackboardValue key="{supply_goal_index_key}" value="0" type="int"/>
      <SetBlackboardValue key="{supply_active_key}" value="0" type="int"/>
    </Sequence>
  </BehaviorTree>
</root>
