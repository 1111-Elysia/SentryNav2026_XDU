<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="RandomWaypointNavigate">
    <KeepRunningUntilFailure>
      <ReactiveSequence name="随机巡逻直到阶段切换">
        <CheckCondition
          key_name="stage_remain_time"
          comparison="gt"
          threshold="{random_wait_time_threshold}"/>
        <Sequence name="随机点导航循环">
          <RandomSelector
            goal_names="{random_goal_names}"
            avoid_repeat="{random_avoid_repeat}"
            goal="{random_goal}"
            goal_name="{random_goal_name}"/>
          <PublishControllerName controller_name="FollowPath"/>
          <ReactiveSequence name="随机巡逻_移动到点">
            <MaintainSentryPosture mode="3"/>
            <ReliableNavigateToPose
              goal="{random_goal}"
              goal_name="{random_goal_name}"
              reach_threshold="{random_reach_threshold}"
              resend_interval="{nav_resend_interval}"
              response_timeout="{nav_response_timeout}"
              result_retry_delay="{nav_result_retry_delay}"/>
          </ReactiveSequence>
          <ReactiveSequence name="随机巡逻_到点停留">
            <MaintainSentryPosture mode="3"/>
            <Wait wait_duration="{random_patrol_wait_duration}"/>
          </ReactiveSequence>
        </Sequence>
      </ReactiveSequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
