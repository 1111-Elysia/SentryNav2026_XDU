<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="PrestartInitReturn">
    <ReactiveSequence name="准备时间回初始点">
      <CheckCondition key_name="game_progress" comparison="eq" threshold="1"/>
      <PrintNode message="{prestart_message}" throttle_ms="2000"/>
      <GoalSelector goal_name="init" goal="{prestart_init_goal}"/>
      <ReliableNavigateToPose
        goal="{prestart_init_goal}"
        goal_name="init"
        reach_threshold="0.10"
        log_throttle_ms="2000"/>
    </ReactiveSequence>
  </BehaviorTree>
</root>
