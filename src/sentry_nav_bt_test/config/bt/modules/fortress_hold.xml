<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="FortressHold">
    <Sequence name="堡垒驻守">
      <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
      <SetBlackboardValue key="uc_fortress_hold_active" value="1" type="int"/>
      <Fallback name="堡垒目标选择">
        <Sequence name="堡垒被敌方占领_转守基地前">
          <CheckCondition key_name="fortress_gain_point_occupancy_status" comparison="gte" threshold="2"/>
          <SetBlackboardValue key="uc_fortress_goal_name" value="init" type="string"/>
          <SetBlackboardValue key="fortress_selected_goal_name" value="init" type="string"/>
          <GoalSelector goal_name="init" goal="{fortress_goal}"/>
        </Sequence>
        <Sequence name="堡垒正常驻守点">
          <SetBlackboardValue key="uc_fortress_goal_name" value="fortress" type="string"/>
          <SetBlackboardValue key="fortress_selected_goal_name" value="fortress" type="string"/>
          <GoalSelector goal_name="fortress" goal="{fortress_goal}"/>
        </Sequence>
      </Fallback>
      <Fallback name="堡垒驻守维持">
        <ReactiveSequence name="已在堡垒驻守半径内">
          <CheckGoalReached goal="{fortress_goal}" threshold="0.30"/>
          <MaintainSentryPosture mode="3"/>
          <Wait wait_duration="0.5"/>
        </ReactiveSequence>
        <Sequence name="回堡垒点位">
          <Fallback name="堡垒移动日志">
            <Sequence name="堡垒被占_打印基地前转守日志">
              <CheckCondition key_name="fortress_gain_point_occupancy_status" comparison="gte" threshold="2"/>
              <PrintNode message="{fortress_enemy_move_message}"/>
            </Sequence>
            <PrintNode message="{fortress_move_message}"/>
          </Fallback>
          <ReactiveSequence name="回堡垒并维持移动姿态">
            <MaintainSentryPosture mode="3"/>
            <ReliableNavigateToPose
              goal="{fortress_goal}"
              goal_name="{fortress_selected_goal_name}"
              reach_threshold="0.25"/>
          </ReactiveSequence>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>
