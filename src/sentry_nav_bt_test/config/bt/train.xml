<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">
  <!-- ////////// -->
  <BehaviorTree ID="MainTree">
    <Fallback name="Root">
      <KeepRunningUntilFailure>
        <Sequence name="裁判系统连接判定">
          <Inverter>
            <Condition ID="CheckCondition"
                       key_name="game_status_received"
                       comparison="eq"
                       threshold="1"/>
          </Inverter>
        </Sequence>
      </KeepRunningUntilFailure>
      <ForceFailure>
        <Fallback name="裁判系统连接成功日志">
          <Condition ID="CheckCondition"
                     key_name="game_status_connected_logged"
                     comparison="eq"
                     threshold="1"/>
          <Sequence name="首次裁判系统连接成功">
            <Condition ID="CheckCondition"
                       key_name="game_status_received"
                       comparison="eq"
                       threshold="1"/>
            <Action ID="PrintNode"
                    message="[UC] 裁判系统已连接，等待比赛开始"
                    throttle_ms="0"/>
            <Action ID="SetBlackboardValue"
                    key="game_status_connected_logged"
                    value="1"
                    type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>
      <KeepRunningUntilFailure>
        <Sequence name="开始比赛检测">
          <Condition ID="CheckCondition"
                     key_name="game_progress"
                     comparison="lte"
                     threshold="3"/>
          <Fallback name="赛前状态复位">
            <Sequence name="赛前状态已复位">
              <Condition ID="CheckCondition"
                         key_name="uc_initialized"
                         comparison="eq"
                         threshold="0"/>
              <Condition ID="CheckCondition"
                         key_name="in_rune_phase"
                         comparison="eq"
                         threshold="0"/>
              <Condition ID="CheckCondition"
                         key_name="uc_supply_active"
                         comparison="eq"
                         threshold="0"/>
              <Condition ID="CheckCondition"
                         key_name="uc_fortress_hold_active"
                         comparison="eq"
                         threshold="0"/>
            </Sequence>
            <Sequence name="执行赛前复位">
              <Action ID="PrintNode"
                      message="[UC] 比赛未开始，重置局内状态"
                      throttle_ms="0"/>
              <Action ID="SetBlackboardValue"
                      key="uc_initialized"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="in_rune_phase"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="uc_supply_active"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="uc_fortress_hold_active"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="uc_fortress_goal_name"
                      value="fortress"
                      type="string"/>
            </Sequence>
          </Fallback>
        </Sequence>
      </KeepRunningUntilFailure>
      <ForceFailure>
        <Fallback name="初始化">
          <Condition ID="CheckCondition"
                     key_name="uc_initialized"
                     comparison="eq"
                     threshold="1"/>
          <Sequence name="初始化状态">
            <Action ID="PrintNode"
                    message="[UC] 比赛开始，初始化局内状态"
                    throttle_ms="0"/>
            <Action ID="SetBlackboardValue"
                    key="in_rune_phase"
                    value="0"
                    type="int"/>
            <Action ID="SetBlackboardValue"
                    key="uc_supply_active"
                    value="0"
                    type="int"/>
            <Action ID="SetBlackboardValue"
                    key="uc_fortress_hold_active"
                    value="0"
                    type="int"/>
            <Action ID="SetBlackboardValue"
                    key="uc_fortress_goal_name"
                    value="fortress"
                    type="string"/>
            <Action ID="SetBlackboardValue"
                    key="uc_initialized"
                    value="1"
                    type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>
      <ReactiveSequence name="主循环_Root">
        <Sequence name="前置检查">
          <Condition ID="CheckCondition"
                     key_name="game_status_received"
                     comparison="eq"
                     threshold="1"/>
          <Condition ID="CheckCondition"
                     key_name="game_progress"
                     comparison="eq"
                     threshold="4"/>
        </Sequence>
        <ReactiveFallback name="主逻辑_MainLogic">
          <SubTree ID="Resurrection"
                   _autoremap="true"/>
          <Sequence name="作战模式">
            <Parallel failure_count="1"
                      success_count="-1">
              <ReactiveFallback name="全场策略机">
                <SubTree ID="RandomWaypointNavigate"
                         random_goal_names="point1,point2,point3,point4,point5"
                         random_avoid_repeat="true"
                         random_reach_threshold="0.25"
                         random_patrol_wait_duration="3.0"
                         random_wait_time_threshold="0"
                         nav_resend_interval="0.30"
                         nav_response_timeout="0.80"
                         nav_result_retry_delay="0.30"
                         _autoremap="true"/>
              </ReactiveFallback>
            </Parallel>
          </Sequence>
        </ReactiveFallback>
      </ReactiveSequence>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="CheckCondition"
               editable="true">
      <input_port name="key_name"/>
      <input_port name="comparison"/>
      <input_port name="threshold"/>
    </Condition>
    <Action ID="PrintNode"
            editable="true">
      <input_port name="message"/>
      <input_port name="throttle_ms"/>
    </Action>
    <Action ID="SetBlackboardValue"
            editable="true">
      <input_port name="key"/>
      <input_port name="value"/>
      <input_port name="type"/>
    </Action>
  </TreeNodesModel>

</root>
