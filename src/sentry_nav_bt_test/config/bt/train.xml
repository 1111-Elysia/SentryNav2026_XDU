<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">
  <!-- ////////// -->
  <BehaviorTree ID="MainTree">
    <Fallback name="Root">
      <KeepRunningUntilFailure>
        <Sequence name="裁判系统连接判定">
          <Inverter>
            <Condition ID="CheckCondition"
                       key_name="game_status_received"
                       comparison="eq"
                       threshold="1"/>
          </Inverter>
        </Sequence>
      </KeepRunningUntilFailure>
      <ForceFailure>
        <Fallback name="裁判系统连接成功日志">
          <Condition ID="CheckCondition"
                     key_name="game_status_connected_logged"
                     comparison="eq"
                     threshold="1"/>
          <Sequence name="首次裁判系统连接成功">
            <Condition ID="CheckCondition"
                       key_name="game_status_received"
                       comparison="eq"
                       threshold="1"/>
            <Action ID="PrintNode"
                    message="[UC] 裁判系统已连接，等待比赛开始"
                    throttle_ms="0"/>
            <Action ID="SetBlackboardValue"
                    key="game_status_connected_logged"
                    value="1"
                    type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>
      <KeepRunningUntilFailure>
        <Sequence name="开始比赛检测">
          <Condition ID="CheckCondition"
                     key_name="game_progress"
                     comparison="lte"
                     threshold="3"/>
          <Fallback name="赛前状态复位">
            <Sequence name="赛前状态已复位">
              <Condition ID="CheckCondition"
                         key_name="uc_initialized"
                         comparison="eq"
                         threshold="0"/>
              <Condition ID="CheckCondition"
                         key_name="in_rune_phase"
                         comparison="eq"
                         threshold="0"/>
              <Condition ID="CheckCondition"
                         key_name="uc_supply_active"
                         comparison="eq"
                         threshold="0"/>
              <Condition ID="CheckCondition"
                         key_name="uc_fortress_hold_active"
                         comparison="eq"
                         threshold="0"/>
              <Condition ID="CheckCondition"
                         key_name="train_chase_active"
                         comparison="eq"
                         threshold="0"/>
              <Condition ID="CheckCondition"
                         key_name="train_chase_started"
                         comparison="eq"
                         threshold="0"/>
              <Condition ID="CheckCondition"
                         key_name="train_vw_active"
                         comparison="eq"
                         threshold="0"/>
            </Sequence>
            <Sequence name="执行赛前复位">
              <Action ID="PrintNode"
                      message="[UC] 比赛未开始，重置局内状态"
                      throttle_ms="0"/>
              <Action ID="SetBlackboardValue"
                      key="uc_initialized"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="in_rune_phase"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="uc_supply_active"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="uc_fortress_hold_active"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="train_chase_active"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="train_chase_started"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="train_vw_active"
                      value="0"
                      type="int"/>
              <Action ID="SetBlackboardValue"
                      key="uc_fortress_goal_name"
                      value="fortress"
                      type="string"/>
            </Sequence>
          </Fallback>
        </Sequence>
      </KeepRunningUntilFailure>
      <ForceFailure>
        <Fallback name="初始化">
          <Condition ID="CheckCondition"
                     key_name="uc_initialized"
                     comparison="eq"
                     threshold="1"/>
          <Sequence name="初始化状态">
            <Action ID="PrintNode"
                    message="[UC] 比赛开始，初始化局内状态"
                    throttle_ms="0"/>
            <Action ID="SetBlackboardValue"
                    key="in_rune_phase"
                    value="0"
                    type="int"/>
            <Action ID="SetBlackboardValue"
                    key="uc_supply_active"
                    value="0"
                    type="int"/>
            <Action ID="SetBlackboardValue"
                    key="uc_fortress_hold_active"
                    value="0"
                    type="int"/>
            <Action ID="SetBlackboardValue"
                    key="train_chase_active"
                    value="0"
                    type="int"/>
            <Action ID="SetBlackboardValue"
                    key="train_chase_started"
                    value="0"
                    type="int"/>
            <Action ID="SetBlackboardValue"
                    key="train_vw_active"
                    value="0"
                    type="int"/>
            <Action ID="SetBlackboardValue"
                    key="uc_fortress_goal_name"
                    value="fortress"
                    type="string"/>
            <Action ID="SetBlackboardValue"
                    key="uc_initialized"
                    value="1"
                    type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>
      <ReactiveSequence name="主循环_Root">
        <Sequence name="前置检查">
          <Condition ID="CheckCondition"
                     key_name="game_status_received"
                     comparison="eq"
                     threshold="1"/>
          <Condition ID="CheckCondition"
                     key_name="game_progress"
                     comparison="eq"
                     threshold="4"/>
        </Sequence>
        <ForceSuccess>
          <MaintainSentryPosture mode="1"/>
        </ForceSuccess>
        <ForceSuccess>
          <Fallback name="受击VW控制">
            <Sequence name="受击期间持续发布VW1">
              <CheckCondition key_name="is_under_attack"
                              comparison="eq"
                              threshold="1"/>
              <SubTree ID="UnderAttackVw"
                       high_hp_threshold="150"
                       high_hp_vw="1.0"
                       low_hp_threshold="150"
                       low_hp_vw="1.0"
                       republish_interval_ms="50"
                       _autoremap="true"/>
              <SetBlackboardValue key="train_vw_active"
                                  value="1"
                                  type="int"/>
            </Sequence>
            <Sequence name="受击结束只发布一次VW0">
              <CheckCondition key_name="is_under_attack"
                              comparison="eq"
                              threshold="0"/>
              <CheckCondition key_name="train_vw_active"
                              comparison="eq"
                              threshold="1"/>
              <PublishVw value="0.0"
                         republish_interval_ms="0"/>
              <SetBlackboardValue key="train_vw_active"
                                  value="0"
                                  type="int"/>
            </Sequence>
          </Fallback>
        </ForceSuccess>
        <ReactiveFallback name="主逻辑_MainLogic">
          <SubTree ID="Resurrection"
                   _autoremap="true"/>
          <Sequence name="作战模式">
            <Parallel failure_count="1"
                      success_count="-1">
              <ReactiveFallback name="全场策略机">
                <ReactiveSequence name="发现目标后追击">
                  <TargetDetected topic_name="/target/distance"
                                  lost_timeout="1.0"/>
                  <Sequence name="巡逻切换到追击">
                    <Action ID="SetBlackboardValue"
                            key="train_chase_active"
                            value="1"
                            type="int"/>
                    <Action ID="SetBlackboardValue"
                            key="train_chase_started"
                            value="1"
                            type="int"/>
                    <Action ID="Wait"
                            wait_duration="0.60"/>
                    <SubTree ID="Chase"
                             chase_active_key="train_chase_active"
                             chase_message="[Train] 检测到目标，进入动态追击"
                             chase_log_throttle_ms="2000"
                             chase_posture="1"
                             chase_planner="ElasticTracker"
                             chase_fallback_planner="GridBased"
                             chase_planner_topic="/planner_name"
                             _autoremap="true"/>
                  </Sequence>
                </ReactiveSequence>
                <Sequence name="无目标时随机巡逻">
                  <Action ID="SetBlackboardValue"
                          key="train_chase_active"
                          value="0"
                          type="int"/>
                  <Fallback name="首次巡逻无需切换等待">
                    <Condition ID="CheckCondition"
                               key_name="train_chase_started"
                               comparison="eq"
                               threshold="0"/>
                    <Action ID="Wait"
                            wait_duration="0.60"/>
                  </Fallback>
                  <SubTree ID="RandomWaypointNavigate"
                           random_goal_names="point1,point2,point3,point4,point5"
                           random_avoid_repeat="true"
                           random_patrol_posture="1"
                           random_reach_threshold="0.25"
                           random_patrol_wait_duration="3.0"
                           random_wait_time_threshold="0"
                           nav_resend_interval="0.30"
                           nav_response_timeout="0.80"
                           nav_result_retry_delay="0.30"
                           _autoremap="true"/>
                </Sequence>
              </ReactiveFallback>
            </Parallel>
          </Sequence>
        </ReactiveFallback>
      </ReactiveSequence>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="CheckCondition"
               editable="true">
      <input_port name="key_name"/>
      <input_port name="comparison"/>
      <input_port name="threshold"/>
    </Condition>
    <Action ID="PrintNode"
            editable="true">
      <input_port name="message"/>
      <input_port name="throttle_ms"/>
    </Action>
    <Action ID="SetBlackboardValue"
            editable="true">
      <input_port name="key"/>
      <input_port name="value"/>
      <input_port name="type"/>
    </Action>
  </TreeNodesModel>

</root>
