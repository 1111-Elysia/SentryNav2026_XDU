<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Fallback name="Root">
      <KeepRunningUntilFailure>
        <Sequence name="裁判系统连接判定">
          <Inverter>
            <CheckCondition
                       key_name="game_status_received"
                       comparison="eq"
                       threshold="1"/>
          </Inverter>
        </Sequence>
      </KeepRunningUntilFailure>
      <ForceFailure>
        <Fallback name="裁判系统连接成功日志">
          <CheckCondition
                     key_name="game_status_connected_logged"
                     comparison="eq"
                     threshold="1"/>
          <Sequence name="首次裁判系统连接成功">
            <CheckCondition
                       key_name="game_status_received"
                       comparison="eq"
                       threshold="1"/>
            <PrintNode
                    message="[UC] 裁判系统已连接，等待比赛开始"/>
            <SetBlackboardValue
                    key="game_status_connected_logged"
                    value="1"
                    type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>
      <KeepRunningUntilFailure>
        <Sequence name="开始比赛检测">
          <CheckCondition
                     key_name="game_progress"
                     comparison="lte"
                     threshold="3"/>
          <Fallback name="赛前状态复位">
            <Sequence name="赛前状态已复位">
              <CheckCondition
                         key_name="uc_initialized"
                         comparison="eq"
                         threshold="0"/>
              <CheckCondition
                         key_name="in_rune_phase"
                         comparison="eq"
                         threshold="0"/>
              <CheckCondition
                         key_name="uc_supply_active"
                         comparison="eq"
                         threshold="0"/>
              <CheckCondition
                         key_name="uc_fortress_hold_active"
                         comparison="eq"
                         threshold="0"/>
            </Sequence>
            <Sequence name="执行赛前复位">
              <PrintNode
                      message="[UC] 比赛未开始，重置局内状态"/>
              <SetBlackboardValue
                      key="uc_initialized"
                      value="0"
                      type="int"/>
              <SetBlackboardValue
                      key="in_rune_phase"
                      value="0"
                      type="int"/>
              <SetBlackboardValue
                      key="uc_supply_active"
                      value="0"
                      type="int"/>
              <SetBlackboardValue
                      key="uc_fortress_hold_active"
                      value="0"
                      type="int"/>
              <SetBlackboardValue
                      key="uc_fortress_goal_name"
                      value="fortress"
                      type="string"/>
            </Sequence>
          </Fallback>
        </Sequence>
      </KeepRunningUntilFailure>
      <ForceFailure>
        <Fallback name="初始化">
          <CheckCondition
                     key_name="uc_initialized"
                     comparison="eq"
                     threshold="1"/>
          <Sequence name="初始化状态">
            <PrintNode
                    message="[UC] 比赛开始，初始化局内状态"/>
            <SetBlackboardValue
                    key="in_rune_phase"
                    value="0"
                    type="int"/>
            <SetBlackboardValue
                    key="uc_supply_active"
                    value="0"
                    type="int"/>
            <SetBlackboardValue
                    key="uc_fortress_hold_active"
                    value="0"
                    type="int"/>
            <SetBlackboardValue
                    key="uc_fortress_goal_name"
                    value="fortress"
                    type="string"/>
            <SetBlackboardValue
                    key="uc_initialized"
                    value="1"
                    type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>
      <Sequence name="主循环_Root">
        <Sequence name="前置检查">
          <CheckCondition
                     key_name="game_status_received"
                     comparison="eq"
                     threshold="1"/>
          <CheckCondition
                     key_name="game_progress"
                     comparison="eq"
                     threshold="4"/>
        </Sequence>
        <ReactiveFallback name="主逻辑_MainLogic">
          <SubTree ID="Resurrection"
                       _autoremap="1"/>
          <Sequence name="作战模式">
            <Parallel failure_count="1"
                      success_count="-1">
              <Fallback name="受击姿态辅助">
                <Sequence name="非打符阶段受击切进攻">
                  <CheckCondition
                             key_name="is_under_attack"
                             comparison="eq"
                             threshold="1"/>
                  <CheckCondition
                             key_name="in_rune_phase"
                             comparison="eq"
                             threshold="0"/>
                  <MaintainSentryPosture
                          mode="1"/>
                </Sequence>
                <CheckCondition
                           key_name="game_progress"
                           comparison="eq"
                           threshold="4"/>
              </Fallback>
              <ReactiveFallback name="全场策略机">
                <Sequence name="点位1">
                  <CheckCondition
                             key_name="stage_remain_time"
                             comparison="gt"
                             threshold="360"/>
                  <SubTree ID="GoWaitUntilTimeAbove"
                               point_goal_name="outpost_point"
                               point_reach_threshold="0.25"
                               point_wait_time_threshold="360"
                               point_move_posture="3"
                               point_wait_posture="1"
                               point_start_message="前往点位1"
                               point_arrived_message="已到达点位1，等待阶段切换"
                               rune_phase_key="in_rune_phase"
                               fortress_active_key="uc_fortress_hold_active"
                               nav_resend_interval="0.30"
                               nav_response_timeout="0.80"
                               nav_result_retry_delay="0.30"
                               _autoremap="1"/>
                </Sequence>
                <Sequence name="点位2">
                  <CheckCondition
                             key_name="stage_remain_time"
                             comparison="gt"
                             threshold="300"/>
                  <SubTree ID="GoWaitUntilTimeAbove"
                               fortress_active_key="uc_fortress_hold_active"
                               nav_resend_interval="0.30"
                               nav_response_timeout="0.80"
                               nav_result_retry_delay="0.30"
                               point_arrived_message="已到达点位2，等待阶段切换"
                               point_goal_name="small_rune_point"
                               point_move_posture="3"
                               point_reach_threshold="0.25"
                               point_start_message="前往点位2"
                               point_wait_posture="1"
                               point_wait_time_threshold="300"
                               rune_phase_key="in_rune_phase"
                               _autoremap="1"/>
                </Sequence>
                <Sequence name="点位3">
                  <CheckCondition
                             key_name="stage_remain_time"
                             comparison="gt"
                             threshold="240"/>
                  <SubTree ID="GoWaitUntilTimeAbove"
                               fortress_active_key="uc_fortress_hold_active"
                               nav_resend_interval="0.30"
                               nav_response_timeout="0.80"
                               nav_result_retry_delay="0.30"
                               point_arrived_message="已到达点位3，等待阶段切换"
                               point_goal_name="large_rune_point"
                               point_move_posture="3"
                               point_reach_threshold="0.25"
                               point_start_message="前往点位3"
                               point_wait_posture="1"
                               point_wait_time_threshold="240"
                               rune_phase_key="in_rune_phase"
                               _autoremap="1"/>
                </Sequence>
                <Sequence name="堡垒">
                  <SubTree ID="FortressHold"
                               fortress_goal_name="fortress"
                               fortress_arrive_threshold="0.25"
                               fortress_hold_exit_threshold="0.30"
                               fortress_move_posture="3"
                               fortress_hold_posture="1"
                               fortress_wait_duration="0.5"
                               fortress_move_message="回到堡垒点位持续驻守"
                               rune_phase_key="in_rune_phase"
                               fortress_active_key="uc_fortress_hold_active"
                               fortress_goal_name_key="uc_fortress_goal_name"
                               nav_resend_interval="0.30"
                               nav_response_timeout="0.80"
                               nav_result_retry_delay="0.30"
                               _autoremap="1"/>
                </Sequence>
              </ReactiveFallback>
            </Parallel>
          </Sequence>
        </ReactiveFallback>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="CheckCondition"
               editable="true">
      <input_port name="key_name"/>
      <input_port name="comparison"/>
      <input_port name="threshold"/>
    </Condition>
    <Action ID="MaintainSentryPosture"
            editable="true">
      <input_port name="mode"
                  type="int">1:Attack, 2:Defend, 3:Move</input_port>
      <input_port name="cooldown_ms"
                  type="int">姿态切换冷却时间</input_port>
    </Action>
    <Action ID="PrintNode"
            editable="true">
      <input_port name="message"/>
      <input_port name="throttle_ms"/>
    </Action>
    <Action ID="SetBlackboardValue"
            editable="true">
      <input_port name="key"/>
      <input_port name="value"/>
      <input_port name="type"/>
    </Action>
  </TreeNodesModel>

</root>
