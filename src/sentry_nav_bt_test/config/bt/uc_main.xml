<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="Root">
      <KeepRunningUntilFailure>
        <Sequence name="裁判系统连接判定">
          <Inverter>
            <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
          </Inverter>
        </Sequence>
      </KeepRunningUntilFailure>

      <ForceFailure>
        <Fallback name="裁判系统连接成功日志">
          <CheckCondition key_name="game_status_connected_logged" comparison="eq" threshold="1"/>
          <Sequence name="首次裁判系统连接成功">
            <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
            <PrintNode message="[UC] 裁判系统已连接，等待比赛开始"/>
            <SetBlackboardValue key="game_status_connected_logged" value="1" type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>

      <KeepRunningUntilFailure>
        <Sequence name="开始比赛检测">
          <CheckCondition key_name="game_progress" comparison="lte" threshold="3"/>
          <Fallback name="赛前状态复位">
            <Sequence name="赛前状态已复位">
              <CheckCondition key_name="uc_initialized" comparison="eq" threshold="0"/>
              <CheckCondition key_name="in_rune_phase" comparison="eq" threshold="0"/>
              <CheckCondition key_name="uc_supply_active" comparison="eq" threshold="0"/>
              <CheckCondition key_name="uc_outpost_active" comparison="eq" threshold="0"/>
              <CheckCondition key_name="uc_fortress_hold_active" comparison="eq" threshold="0"/>
              <CheckCondition key_name="uc_normal_posture" comparison="eq" threshold="3"/>
            </Sequence>
            <Sequence name="执行赛前复位">
              <PrintNode message="[UC] 比赛未开始，重置局内状态"/>
              <SetBlackboardValue key="uc_initialized" value="0" type="int"/>
              <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
              <SetBlackboardValue key="uc_supply_active" value="0" type="int"/>
              <SetBlackboardValue key="uc_outpost_active" value="0" type="int"/>
              <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
              <SetBlackboardValue key="uc_normal_posture" value="3" type="int"/>
              <SetBlackboardValue key="uc_fortress_goal_name" value="fortress" type="string"/>
            </Sequence>
          </Fallback>
        </Sequence>
      </KeepRunningUntilFailure>

      <ForceFailure>
        <Fallback name="初始化">
          <CheckCondition key_name="uc_initialized" comparison="eq" threshold="1"/>
          <Sequence name="初始化状态">
            <PrintNode message="[UC] 比赛开始，初始化局内状态"/>
            <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
            <SetBlackboardValue key="uc_supply_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_outpost_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_normal_posture" value="3" type="int"/>
            <SetBlackboardValue key="uc_fortress_goal_name" value="fortress" type="string"/>
            <SetBlackboardValue key="uc_initialized" value="1" type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>

      <Sequence name="主循环_Root">
        <Sequence name="前置检查">
          <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
          <CheckCondition key_name="game_progress" comparison="eq" threshold="4"/>
        </Sequence>

        <ReactiveFallback name="主逻辑_MainLogic">
          <SubTree ID="Resurrection" _autoremap="1"/>

          <SubTree
            ID="SupplyReturn"
            supply_goal_names="supply_point,supply_point_2"
            supply_goal_index_key="uc_supply_goal_index"
            supply_low_hp_threshold="150"
            supply_low_ammo_threshold="50"
            supply_ready_ammo_threshold="150"
            supply_reach_threshold="0.25"
            supply_start_message="[回补] 低血或没弹，回补给区休整"
            supply_done_message="[回补] 血量已满且允许发弹量不低于150，退出回补状态"
            supply_active_key="uc_supply_active"
            supply_rfid_detected_key="rfid_supply_zone_detected"
            rune_phase_key="in_rune_phase"
            fortress_active_key="uc_fortress_hold_active"
            nav_resend_interval="0.30"
            nav_response_timeout="0.80"
            nav_result_retry_delay="0.30"
            _autoremap="1"/>

          <Sequence name="作战模式">
            <CheckCondition key_name="uc_supply_active" comparison="eq" threshold="0"/>
            <CheckCondition key_name="current_hp" comparison="gte" threshold="150"/>
            <Parallel success_count="-1" failure_count="1">
              <Sequence name="普通姿态目标更新">
                <SetBlackboardValue key="uc_outpost_active" value="0" type="int"/>
                <Fallback name="普通姿态目标选择">
                  <Sequence name="普通受击目标进攻">
                    <CheckCondition key_name="is_under_attack" comparison="eq" threshold="1"/>
                    <SetBlackboardValue key="uc_normal_posture" value="1" type="int"/>
                  </Sequence>
                  <SetBlackboardValue key="uc_normal_posture" value="3" type="int"/>
                </Fallback>
              </Sequence>

              <ReactiveFallback name="全场策略机">
                <Sequence name="前期_小符_Phase1">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="390"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="small"
                    rune_goal_name="small_rune_point"
                    rune_reach_threshold="0.10"
                    rune_move_posture="{uc_normal_posture}"
                    rune_posture="2"
                    rune_timeout_ms="30000"
                    rune_request_interval_ms="1000"
                    rune_start_message="[Phase 1 | 7:00-6:30] 前往小符点位，准备激活小能量机关"
                    rune_arrived_message="[Phase 1 | 7:00-6:30] 到达小符点位，准备请求小能量机关"
                    rune_done_message="[Phase 1 | 7:00-6:30] 小能量机关流程结束"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="前期_小符补打优先_Phase1Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="330"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="small"
                    rune_goal_name="small_rune_point"
                    rune_reach_threshold="0.10"
                    rune_move_posture="{uc_normal_posture}"
                    rune_posture="2"
                    rune_timeout_ms="30000"
                    rune_request_interval_ms="1000"
                    rune_start_message="[Phase 1 Carry | 6:30-5:30] 若小符仍可进入激活窗口，优先补打小能量机关"
                    rune_arrived_message="[Phase 1 Carry | 6:30-5:30] 到达小符点位，准备继续激活小能量机关"
                    rune_done_message="[Phase 1 Carry | 6:30-5:30] 小能量机关补打流程结束"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="前期_前哨站_Phase2">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="330"/>
                  <SubTree
                    ID="OutpostTask"
                    outpost_goal_name="outpost_point"
                    outpost_reach_threshold="0.25"
                    outpost_wait_time_threshold="330"
                    outpost_move_posture="{uc_normal_posture}"
                    outpost_active_key="uc_outpost_active"
                    outpost_timeout_ms="70000"
                    outpost_start_message="[Phase 2 | 6:30-5:30] 开局小符结束，前往前哨站点位"
                    outpost_arrived_message="[Phase 2 | 6:30-5:30] 已到达前哨站点位，开始打前哨站"
                    outpost_done_message="[Phase 2 | 6:30-5:30] 前哨站流程结束，等待阶段切换完成"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="前期_小符_Phase3">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="300"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="small"
                    rune_goal_name="small_rune_point"
                    rune_reach_threshold="0.10"
                    rune_move_posture="{uc_normal_posture}"
                    rune_posture="2"
                    rune_timeout_ms="30000"
                    rune_request_interval_ms="1000"
                    rune_start_message="[Phase 3 | 5:30-5:00] 再次前往小符点位，尝试激活小能量机关"
                    rune_arrived_message="[Phase 3 | 5:30-5:00] 到达小符点位，准备请求小能量机关"
                    rune_done_message="[Phase 3 | 5:30-5:00] 小能量机关流程结束"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="前期_小符补打优先_Phase3Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="240"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="small"
                    rune_goal_name="small_rune_point"
                    rune_reach_threshold="0.10"
                    rune_move_posture="{uc_normal_posture}"
                    rune_posture="2"
                    rune_timeout_ms="30000"
                    rune_request_interval_ms="1000"
                    rune_start_message="[Phase 3 Carry | 5:00-4:00] 若小符仍可进入激活窗口，优先补打小能量机关"
                    rune_arrived_message="[Phase 3 Carry | 5:00-4:00] 到达小符点位，准备继续激活小能量机关"
                    rune_done_message="[Phase 3 Carry | 5:00-4:00] 小能量机关补打流程结束"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <ReactiveSequence name="中期_堡垒_Phase4">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="240"/>
                  <SubTree
                    ID="FortressHold"
                    fortress_goal_name="fortress"
                    fortress_enemy_goal_name="init"
                    fortress_arrive_threshold="0.25"
                    fortress_hold_exit_threshold="0.30"
                    fortress_move_posture="3"
                    fortress_hold_posture="1"
                    fortress_wait_duration="0.5"
                    fortress_move_message="[Phase 4 | 5:00-4:00] 不需要打符，回堡垒点位持续驻守"
                    fortress_enemy_move_message="[Phase 4 | 5:00-4:00] 堡垒被敌方占领，转守基地前点位"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    fortress_goal_name_key="uc_fortress_goal_name"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </ReactiveSequence>

                <Sequence name="中期_大符_Phase5">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="210"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_goal_name="large_rune_point"
                    rune_reach_threshold="0.10"
                    rune_move_posture="{uc_normal_posture}"
                    rune_posture="2"
                    rune_timeout_ms="30000"
                    rune_request_interval_ms="1000"
                    rune_start_message="[Phase 5 | 4:00-3:30] 前往大符点位，准备激活大能量机关"
                    rune_arrived_message="[Phase 5 | 4:00-3:30] 到达大符点位，准备请求大能量机关"
                    rune_done_message="[Phase 5 | 4:00-3:30] 大能量机关流程结束"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="中期_大符补打优先_Phase5Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="165"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_goal_name="large_rune_point"
                    rune_reach_threshold="0.10"
                    rune_move_posture="{uc_normal_posture}"
                    rune_posture="2"
                    rune_timeout_ms="30000"
                    rune_request_interval_ms="1000"
                    rune_start_message="[Phase 5 Carry | 3:30-2:45] 若大符仍可进入激活窗口，优先补打大能量机关"
                    rune_arrived_message="[Phase 5 Carry | 3:30-2:45] 到达大符点位，准备继续激活大能量机关"
                    rune_done_message="[Phase 5 Carry | 3:30-2:45] 大能量机关补打流程结束"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <ReactiveSequence name="中期_堡垒_Phase6">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="165"/>
                  <SubTree
                    ID="FortressHold"
                    fortress_goal_name="fortress"
                    fortress_enemy_goal_name="init"
                    fortress_arrive_threshold="0.25"
                    fortress_hold_exit_threshold="0.30"
                    fortress_move_posture="3"
                    fortress_hold_posture="1"
                    fortress_wait_duration="0.5"
                    fortress_move_message="[Phase 6 | 3:30-2:45] 前往堡垒点位并进入驻守"
                    fortress_enemy_move_message="[Phase 6 | 3:30-2:45] 堡垒被敌方占领，转守基地前点位"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    fortress_goal_name_key="uc_fortress_goal_name"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </ReactiveSequence>

                <Sequence name="中期_大符_Phase7">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="135"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_goal_name="large_rune_point"
                    rune_reach_threshold="0.10"
                    rune_move_posture="{uc_normal_posture}"
                    rune_posture="2"
                    rune_timeout_ms="30000"
                    rune_request_interval_ms="1000"
                    rune_start_message="[Phase 7 | 2:45-2:15] 再次前往大符点位，尝试激活大能量机关"
                    rune_arrived_message="[Phase 7 | 2:45-2:15] 到达大符点位，准备请求大能量机关"
                    rune_done_message="[Phase 7 | 2:45-2:15] 大能量机关流程结束"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="中期_大符补打优先_Phase7Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="90"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_goal_name="large_rune_point"
                    rune_reach_threshold="0.10"
                    rune_move_posture="{uc_normal_posture}"
                    rune_posture="2"
                    rune_timeout_ms="30000"
                    rune_request_interval_ms="1000"
                    rune_start_message="[Phase 7 Carry | 2:15-1:30] 若大符仍可进入激活窗口，优先补打大能量机关"
                    rune_arrived_message="[Phase 7 Carry | 2:15-1:30] 到达大符点位，准备继续激活大能量机关"
                    rune_done_message="[Phase 7 Carry | 2:15-1:30] 大能量机关补打流程结束"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <ReactiveSequence name="后期_堡垒_Phase8">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="90"/>
                  <SubTree
                    ID="FortressHold"
                    fortress_goal_name="fortress"
                    fortress_enemy_goal_name="init"
                    fortress_arrive_threshold="0.25"
                    fortress_hold_exit_threshold="0.30"
                    fortress_move_posture="3"
                    fortress_hold_posture="1"
                    fortress_wait_duration="0.5"
                    fortress_move_message="[Phase 8 | 2:15-1:30] 后期回到堡垒点位持续驻守"
                    fortress_enemy_move_message="[Phase 8 | 2:15-1:30] 堡垒被敌方占领，转守基地前点位"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    fortress_goal_name_key="uc_fortress_goal_name"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </ReactiveSequence>

                <Sequence name="后期_条件大符_Phase9">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="60"/>
                  <CheckCondition key_name="ally_base_hp" comparison="gte" threshold="2000"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_goal_name="large_rune_point"
                    rune_reach_threshold="0.10"
                    rune_move_posture="{uc_normal_posture}"
                    rune_posture="2"
                    rune_timeout_ms="30000"
                    rune_request_interval_ms="1000"
                    rune_start_message="[Phase 9 | 1:30-1:00] 基地血量健康，尝试激活大能量机关"
                    rune_arrived_message="[Phase 9 | 1:30-1:00] 到达大符点位，准备请求大能量机关"
                    rune_done_message="[Phase 9 | 1:30-1:00] 大能量机关流程结束"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </Sequence>

                <ReactiveSequence name="全局_堡垒驻守">
                  <SubTree
                    ID="FortressHold"
                    fortress_goal_name="fortress"
                    fortress_enemy_goal_name="init"
                    fortress_arrive_threshold="0.25"
                    fortress_hold_exit_threshold="0.30"
                    fortress_move_posture="3"
                    fortress_hold_posture="1"
                    fortress_wait_duration="0.5"
                    fortress_move_message="[Fallback] 不需要打符，回堡垒点位持续驻守"
                    fortress_enemy_move_message="[Fallback] 堡垒被敌方占领，转守基地前点位"
                    rune_phase_key="in_rune_phase"
                    fortress_active_key="uc_fortress_hold_active"
                    fortress_goal_name_key="uc_fortress_goal_name"
                    nav_resend_interval="0.30"
                    nav_response_timeout="0.80"
                    nav_result_retry_delay="0.30"
                    _autoremap="1"/>
                </ReactiveSequence>
              </ReactiveFallback>

              <ForceSuccess>
                <Sequence name="普通姿态维持">
                  <CheckCondition key_name="in_rune_phase" comparison="eq" threshold="0"/>
                  <CheckCondition key_name="uc_fortress_hold_active" comparison="eq" threshold="0"/>
                  <CheckCondition key_name="uc_outpost_active" comparison="eq" threshold="0"/>
                  <MaintainSentryPosture mode="{uc_normal_posture}"/>
                </Sequence>
              </ForceSuccess>
            </Parallel>
          </Sequence>
        </ReactiveFallback>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="SetSentryPosture" editable="true">
      <input_port name="mode" type="int">1:Attack, 2:Defend, 3:Move</input_port>
      <input_port name="timeout_ms" type="int">姿态切换等待超时</input_port>
      <input_port name="cooldown_ms" type="int">姿态切换冷却时间</input_port>
    </Action>
    <Action ID="MaintainSentryPosture" editable="true">
      <input_port name="mode" type="int">1:Attack, 2:Defend, 3:Move</input_port>
      <input_port name="cooldown_ms" type="int">姿态切换冷却时间</input_port>
    </Action>
    <Action ID="RequestActivateRune" editable="true">
      <input_port name="posture" type="int">请求时保持的姿态</input_port>
      <input_port name="protocol_ver" type="string">old or new</input_port>
    </Action>
    <Action ID="ConfirmResurrection" editable="true">
      <input_port name="posture"/>
      <input_port name="burst_count"/>
      <input_port name="burst_interval_ms"/>
      <input_port name="min_interval_ms"/>
    </Action>
    <Action ID="BuySentryProjectile" editable="true">
      <input_port name="target_allowance"/>
      <input_port name="max_exchange_projectile"/>
      <input_port name="reserve_gold"/>
      <input_port name="buy_step"/>
      <input_port name="min_interval_ms"/>
      <input_port name="posture"/>
      <input_port name="response_timeout_ms"/>
    </Action>
    <Action ID="EngageRune" editable="true">
      <input_port name="rune_type"/>
      <input_port name="posture"/>
      <input_port name="timeout_ms"/>
      <input_port name="request_interval_ms"/>
    </Action>
    <Action ID="EngageOutpost" editable="true">
      <input_port name="timeout_ms"/>
    </Action>
    <Condition ID="CheckCondition" editable="true">
      <input_port name="key_name"/>
      <input_port name="comparison"/>
      <input_port name="threshold"/>
    </Condition>
    <Condition ID="CompareValues" editable="true">
      <input_port name="first_key"/>
      <input_port name="second_key"/>
      <input_port name="comparison"/>
    </Condition>
    <Action ID="GoalSelector" editable="true">
      <input_port name="goal_name"/>
      <output_port name="goal"/>
