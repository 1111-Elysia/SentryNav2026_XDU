<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="Root">
      <KeepRunningUntilFailure>
        <Sequence name="裁判系统连接判定">
          <Inverter>
            <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
          </Inverter>
        </Sequence>
      </KeepRunningUntilFailure>
      <ForceFailure>
        <Fallback name="裁判系统连接成功日志">
          <CheckCondition key_name="game_status_connected_logged" comparison="eq" threshold="1"/>
          <Sequence name="首次裁判系统连接成功">
            <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
            <PrintNode message="[UC] 裁判系统已连接，等待比赛开始"/>
            <SetBlackboardValue key="game_status_connected_logged" value="1" type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>
      <KeepRunningUntilFailure>
        <Sequence name="开始比赛检测">
          <CheckCondition key_name="game_progress" comparison="lte" threshold="3"/>
          <Fallback name="赛前状态复位">
            <Sequence name="赛前状态已复位">
              <CheckCondition key_name="uc_initialized" comparison="eq" threshold="0"/>
              <CheckCondition key_name="in_rune_phase" comparison="eq" threshold="0"/>
              <CheckCondition key_name="uc_supply_active" comparison="eq" threshold="0"/>
              <CheckCondition key_name="uc_fortress_hold_active" comparison="eq" threshold="0"/>
            </Sequence>
            <Sequence name="执行赛前复位">
              <PrintNode message="[UC] 比赛未开始，重置局内状态"/>
              <SetBlackboardValue key="uc_initialized" value="0" type="int"/>
              <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
              <SetBlackboardValue key="uc_supply_active" value="0" type="int"/>
              <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
              <SetBlackboardValue key="uc_fortress_goal_name" value="fortress" type="string"/>
            </Sequence>
          </Fallback>
        </Sequence>
      </KeepRunningUntilFailure>
      <ForceFailure>
        <Fallback name="初始化">
          <CheckCondition key_name="uc_initialized" comparison="eq" threshold="1"/>
          <Sequence name="初始化状态">
            <PrintNode message="[UC] 比赛开始，初始化局内状态"/>
            <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
            <SetBlackboardValue key="uc_supply_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_fortress_goal_name" value="fortress" type="string"/>
            <SetBlackboardValue key="uc_initialized" value="1" type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>
      <Sequence name="主循环_Root">
        <Sequence name="前置检查">
          <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
          <CheckCondition key_name="game_progress" comparison="eq" threshold="4"/>
        </Sequence>
        <ReactiveFallback name="主逻辑_MainLogic">
          <Sequence name="复活机制">
            <CheckCondition key_name="current_hp" comparison="eq" threshold="0"/>
            <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
            <SetBlackboardValue key="uc_supply_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
            <ConfirmResurrection posture="0" burst_count="3" burst_interval_ms="20" min_interval_ms="100"/>
          </Sequence>
          <Sequence name="回补模式">
            <Fallback name="回补触发或保持">
              <CheckCondition key_name="uc_supply_active" comparison="eq" threshold="1"/>
              <Sequence name="触发回补模式">
                <Fallback name="回补触发">
                  <Inverter>
                    <CheckCondition key_name="current_hp" comparison="gte" threshold="150"/>
                  </Inverter>
                  <Sequence>
                    <CheckCondition key_name="current_hp" comparison="gte" threshold="150"/>
                    <CheckCondition key_name="projectile_allowance_17mm" comparison="lte" threshold="50"/>
                  </Sequence>
                </Fallback>
                <SetBlackboardValue key="uc_supply_active" value="1" type="int"/>
                <PrintNode message="[回补] 低血或没弹，回补给区休整"/>
              </Sequence>
            </Fallback>
            <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
            <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
            <GoalSelector goal_name="supply_point" goal="{goal}"/>
            <Inverter>
              <KeepRunningUntilFailure>
                <Sequence name="回补_未补满时持续回补闭环">
                  <Inverter>
                    <Sequence name="回补已完成">
                      <CompareValues first_key="current_hp" second_key="maximum_hp" comparison="gte"/>
                      <CheckCondition key_name="projectile_allowance_17mm" comparison="gte" threshold="100"/>
                    </Sequence>
                  </Inverter>
                  <ReactiveFallback name="回补_RFID保持或重发补给点">
                    <Sequence name="回补_RFID在补给区内_原地等待恢复">
                      <CheckCondition key_name="rfid_supply_zone_detected" comparison="eq" threshold="1"/>
                      <PrintNode message="[回补] 已读到补给区 RFID，保持防御姿态等待恢复" throttle_ms="2000"/>
                      <MaintainSentryPosture mode="2"/>
                      <Wait wait_duration="0.20"/>
                    </Sequence>
                    <RetryUntilSuccessful num_attempts="100">
                      <ReactiveSequence name="回补_RFID丢失_重新发补给点">
                        <PrintNode message="[回补] 未读到补给区 RFID，重新发补给点" throttle_ms="2000"/>
                        <MaintainSentryPosture mode="3"/>
                        <ReliableNavigateToPose goal="{goal}" goal_name="supply_point" reach_threshold="0.25" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30" success_condition_key="rfid_supply_zone_detected" success_condition_comparison="eq" success_condition_threshold="1"/>
                      </ReactiveSequence>
                    </RetryUntilSuccessful>
                  </ReactiveFallback>
                </Sequence>
              </KeepRunningUntilFailure>
            </Inverter>
            <PrintNode message="[回补] 血量和弹量已恢复，退出回补状态"/>
            <SetBlackboardValue key="uc_supply_active" value="0" type="int"/>
          </Sequence>
          <Sequence name="作战模式">
            <CheckCondition key_name="uc_supply_active" comparison="eq" threshold="0"/>
            <CheckCondition key_name="current_hp" comparison="gte" threshold="150"/>
            <Parallel success_count="-1" failure_count="1">
              <Fallback name="受击姿态辅助">
                <Sequence name="打符阶段受击切防御">
                  <CheckCondition key_name="is_under_attack" comparison="eq" threshold="1"/>
                  <CheckCondition key_name="in_rune_phase" comparison="eq" threshold="1"/>
                  <MaintainSentryPosture mode="2"/>
                </Sequence>
                <Sequence name="非打符阶段受击切进攻">
                  <CheckCondition key_name="is_under_attack" comparison="eq" threshold="1"/>
                  <CheckCondition key_name="in_rune_phase" comparison="eq" threshold="0"/>
                  <MaintainSentryPosture mode="1"/>
                </Sequence>
                <CheckCondition key_name="game_progress" comparison="eq" threshold="4"/>
              </Fallback>
              <ReactiveFallback name="全场策略机">
                <Sequence name="前期_小符_Phase1">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="390"/>
                  <Fallback name="Phase1_小符任务允许">
                    <CheckCondition key_name="small_rune_status" comparison="eq" threshold="2"/>
                    <Sequence>
                      <CheckCondition key_name="small_rune_status" comparison="eq" threshold="0"/>
                      <CheckCondition key_name="can_activate_rune" comparison="eq" threshold="1"/>
                    </Sequence>
                  </Fallback>
                  <SetBlackboardValue key="in_rune_phase" value="1" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                  <PrintNode message="[Phase 1 | 7:00-6:30] 前往小符点位，准备激活小能量机关"/>
                  <GoalSelector goal_name="small_rune_point" goal="{goal}"/>
                  <ReactiveSequence name="Phase1_前往小符并维持移动姿态">
                    <MaintainSentryPosture mode="3"/>
                    <ReliableNavigateToPose goal="{goal}" goal_name="small_rune_point" reach_threshold="0.10" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                  </ReactiveSequence>
                  <PrintNode message="[Phase 1 | 7:00-6:30] 到达小符点位，关闭 scan mode，准备请求小能量机关"/>
                  <EngageRune rune_type="small" posture="1" timeout_ms="30000" request_interval_ms="1000"/>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <PrintNode message="[Phase 1 | 7:00-6:30] 小能量机关流程结束"/>
                </Sequence>
                <Sequence name="前期_小符补打优先_Phase1Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="330"/>
                  <Fallback name="Phase1Carry_小符任务允许">
                    <CheckCondition key_name="small_rune_status" comparison="eq" threshold="2"/>
                    <Sequence>
                      <CheckCondition key_name="small_rune_status" comparison="eq" threshold="0"/>
                      <CheckCondition key_name="can_activate_rune" comparison="eq" threshold="1"/>
                    </Sequence>
                  </Fallback>
                  <SetBlackboardValue key="in_rune_phase" value="1" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                  <PrintNode message="[Phase 1 Carry | 6:30-5:30] 若小符仍可进入激活窗口，优先补打小能量机关"/>
                  <GoalSelector goal_name="small_rune_point" goal="{goal}"/>
                  <ReactiveSequence name="Phase1Carry_前往小符并维持移动姿态">
                    <MaintainSentryPosture mode="3"/>
                    <ReliableNavigateToPose goal="{goal}" goal_name="small_rune_point" reach_threshold="0.10" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                  </ReactiveSequence>
                  <PrintNode message="[Phase 1 Carry | 6:30-5:30] 到达小符点位，准备继续激活小能量机关"/>
                  <EngageRune rune_type="small" posture="1" timeout_ms="30000" request_interval_ms="1000"/>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <PrintNode message="[Phase 1 Carry | 6:30-5:30] 小能量机关补打流程结束"/>
                </Sequence>
                <Sequence name="前期_前哨站_Phase2">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="330"/>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                  <PrintNode message="[Phase 2 | 6:30-5:30] 开局小符结束，前往前哨站点位等待阶段切换"/>
                  <GoalSelector goal_name="outpost_point" goal="{goal}"/>
                  <ReactiveSequence name="Phase2_前往前哨并维持移动姿态">
                    <MaintainSentryPosture mode="3"/>
                    <ReliableNavigateToPose goal="{goal}" goal_name="outpost_point" reach_threshold="0.25" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                  </ReactiveSequence>
                  <PrintNode message="[Phase 2 | 6:30-5:30] 已到达前哨站点位，等待阶段切换"/>
                  <ReactiveSequence name="Phase2_等待阶段切换并维持进攻姿态">
                    <MaintainSentryPosture mode="1"/>
                    <KeepRunningUntilFailure>
                      <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="330"/>
                    </KeepRunningUntilFailure>
                  </ReactiveSequence>
                </Sequence>
                <Sequence name="前期_小符_Phase3">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="300"/>
                  <Fallback name="Phase3_小符任务允许">
                    <CheckCondition key_name="small_rune_status" comparison="eq" threshold="2"/>
                    <Sequence>
                      <CheckCondition key_name="small_rune_status" comparison="eq" threshold="0"/>
                      <CheckCondition key_name="can_activate_rune" comparison="eq" threshold="1"/>
                    </Sequence>
                  </Fallback>
                  <SetBlackboardValue key="in_rune_phase" value="1" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                  <PrintNode message="[Phase 3 | 5:30-5:00] 再次前往小符点位，尝试激活小能量机关"/>
                  <GoalSelector goal_name="small_rune_point" goal="{goal}"/>
                  <ReactiveSequence name="Phase3_前往小符并维持移动姿态">
                    <MaintainSentryPosture mode="3"/>
                    <ReliableNavigateToPose goal="{goal}" goal_name="small_rune_point" reach_threshold="0.10" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                  </ReactiveSequence>
                  <PrintNode message="[Phase 3 | 5:30-5:00] 到达小符点位，关闭 scan mode，准备请求小能量机关"/>
                  <EngageRune rune_type="small" posture="1" timeout_ms="30000" request_interval_ms="1000"/>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <PrintNode message="[Phase 3 | 5:30-5:00] 小能量机关流程结束"/>
                </Sequence>
                <Sequence name="前期_小符补打优先_Phase3Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="240"/>
                  <Fallback name="Phase3Carry_小符任务允许">
                    <CheckCondition key_name="small_rune_status" comparison="eq" threshold="2"/>
                    <Sequence>
                      <CheckCondition key_name="small_rune_status" comparison="eq" threshold="0"/>
                      <CheckCondition key_name="can_activate_rune" comparison="eq" threshold="1"/>
                    </Sequence>
                  </Fallback>
                  <SetBlackboardValue key="in_rune_phase" value="1" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                  <PrintNode message="[Phase 3 Carry | 5:00-4:00] 若小符仍可进入激活窗口，优先补打小能量机关"/>
                  <GoalSelector goal_name="small_rune_point" goal="{goal}"/>
                  <ReactiveSequence name="Phase3Carry_前往小符并维持移动姿态">
                    <MaintainSentryPosture mode="3"/>
                    <ReliableNavigateToPose goal="{goal}" goal_name="small_rune_point" reach_threshold="0.10" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                  </ReactiveSequence>
                  <PrintNode message="[Phase 3 Carry | 5:00-4:00] 到达小符点位，准备继续激活小能量机关"/>
                  <EngageRune rune_type="small" posture="1" timeout_ms="30000" request_interval_ms="1000"/>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <PrintNode message="[Phase 3 Carry | 5:00-4:00] 小能量机关补打流程结束"/>
                </Sequence>
                <Fallback name="中期_前哨站_Phase4">
                  <Sequence name="Phase4_退守堡垒驻守">
                    <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="240"/>
                    <CheckCondition key_name="ally_outpost_hp" comparison="lte" threshold="0"/>
                    <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                    <SetBlackboardValue key="uc_fortress_hold_active" value="1" type="int"/>
                    <SetBlackboardValue key="uc_fortress_goal_name" value="fortress" type="string"/>
                    <GoalSelector goal_name="fortress" goal="{goal}"/>
                    <Fallback name="Phase4_堡垒驻守维持">
                      <ReactiveSequence name="Phase4_已在堡垒驻守半径内">
                        <CheckGoalReached goal="{goal}" threshold="{uc_fortress_hold_exit_distance_threshold}"/>
                        <MaintainSentryPosture mode="1"/>
                        <Wait wait_duration="0.5"/>
                      </ReactiveSequence>
                      <Sequence name="Phase4_回堡垒点位">
                        <PrintNode message="[Phase 4 | 5:00-4:00] 前哨站已失，退守堡垒点位并驻守"/>
                        <ReactiveSequence name="Phase4_回堡垒并维持移动姿态">
                          <MaintainSentryPosture mode="3"/>
                          <ReliableNavigateToPose goal="{goal}" goal_name="fortress" reach_threshold="{uc_fortress_hold_distance_threshold}" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                        </ReactiveSequence>
                      </Sequence>
                    </Fallback>
                  </Sequence>
                  <Sequence name="Phase4_防守前哨站点位">
                    <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="240"/>
                    <CheckCondition key_name="ally_outpost_hp" comparison="gt" threshold="0"/>
                    <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                    <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                    <PrintNode message="[Phase 4 | 5:00-4:00] 若前哨站仍存活，前往前哨站点位"/>
                    <GoalSelector goal_name="outpost_point" goal="{goal}"/>
                    <ReactiveSequence name="Phase4_前往前哨并维持移动姿态">
                      <MaintainSentryPosture mode="3"/>
                      <ReliableNavigateToPose goal="{goal}" goal_name="outpost_point" reach_threshold="0.25" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                    </ReactiveSequence>
                    <ReactiveSequence name="Phase4_前哨等待并维持进攻姿态">
                      <MaintainSentryPosture mode="1"/>
                      <KeepRunningUntilFailure>
                        <Sequence name="Phase4_前哨阶段持续条件">
                          <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="240"/>
                          <CheckCondition key_name="ally_outpost_hp" comparison="gt" threshold="0"/>
                        </Sequence>
                      </KeepRunningUntilFailure>
                    </ReactiveSequence>
                  </Sequence>
                </Fallback>
                <Sequence name="中期_大符_Phase5">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="210"/>
                  <Fallback name="Phase5_大符任务允许">
                    <CheckCondition key_name="large_rune_status" comparison="neq" threshold="1"/>
                  </Fallback>
                  <SetBlackboardValue key="in_rune_phase" value="1" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                  <PrintNode message="[Phase 5 | 4:00-3:30] 前往大符点位，到点即视为完成"/>
                  <GoalSelector goal_name="large_rune_point" goal="{goal}"/>
                  <ReactiveSequence name="Phase5_前往大符并维持移动姿态">
                    <MaintainSentryPosture mode="3"/>
                    <ReliableNavigateToPose goal="{goal}" goal_name="large_rune_point" reach_threshold="0.10" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                  </ReactiveSequence>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <PrintNode message="[Phase 5 | 4:00-3:30] 已到达大符点位，原地等待阶段切换"/>
                  <ReactiveSequence name="Phase5_等待阶段切换并维持进攻姿态">
                    <MaintainSentryPosture mode="1"/>
                    <KeepRunningUntilFailure>
                      <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="210"/>
                    </KeepRunningUntilFailure>
                  </ReactiveSequence>
                </Sequence>
                <Sequence name="中期_堡垒_Phase6">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="165"/>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="1" type="int"/>
                  <SetBlackboardValue key="uc_fortress_goal_name" value="fortress" type="string"/>
                  <GoalSelector goal_name="fortress" goal="{goal}"/>
                  <Fallback name="Phase6_堡垒驻守维持">
                    <ReactiveSequence name="Phase6_已在堡垒驻守半径内">
                      <CheckGoalReached goal="{goal}" threshold="{uc_fortress_hold_exit_distance_threshold}"/>
                      <MaintainSentryPosture mode="1"/>
                      <Wait wait_duration="0.5"/>
                    </ReactiveSequence>
                    <Sequence name="Phase6_回堡垒点位">
                      <PrintNode message="[Phase 6 | 3:30-2:45] 前往堡垒点位并进入驻守"/>
                      <ReactiveSequence name="Phase6_回堡垒并维持移动姿态">
                        <MaintainSentryPosture mode="3"/>
                        <ReliableNavigateToPose goal="{goal}" goal_name="fortress" reach_threshold="{uc_fortress_hold_distance_threshold}" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                      </ReactiveSequence>
                    </Sequence>
                  </Fallback>
                </Sequence>
                <Sequence name="中期_大符_Phase7">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="135"/>
                  <Fallback name="Phase7_大符任务允许">
                    <CheckCondition key_name="large_rune_status" comparison="neq" threshold="1"/>
                  </Fallback>
                  <SetBlackboardValue key="in_rune_phase" value="1" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                  <PrintNode message="[Phase 7 | 2:45-2:15] 再次前往大符点位，到点即视为完成"/>
                  <GoalSelector goal_name="large_rune_point" goal="{goal}"/>
                  <ReactiveSequence name="Phase7_前往大符并维持移动姿态">
                    <MaintainSentryPosture mode="3"/>
                    <ReliableNavigateToPose goal="{goal}" goal_name="large_rune_point" reach_threshold="0.10" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                  </ReactiveSequence>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <PrintNode message="[Phase 7 | 2:45-2:15] 已到达大符点位，原地等待阶段切换"/>
                  <ReactiveSequence name="Phase7_等待阶段切换并维持进攻姿态">
                    <MaintainSentryPosture mode="1"/>
                    <KeepRunningUntilFailure>
                      <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="135"/>
                    </KeepRunningUntilFailure>
                  </ReactiveSequence>
                </Sequence>
                <Sequence name="后期_堡垒_Phase8">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="90"/>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="1" type="int"/>
                  <SetBlackboardValue key="uc_fortress_goal_name" value="fortress" type="string"/>
                  <GoalSelector goal_name="fortress" goal="{goal}"/>
                  <Fallback name="Phase8_堡垒驻守维持">
                    <ReactiveSequence name="Phase8_已在堡垒驻守半径内">
                      <CheckGoalReached goal="{goal}" threshold="{uc_fortress_hold_exit_distance_threshold}"/>
                      <MaintainSentryPosture mode="1"/>
                      <Wait wait_duration="0.5"/>
                    </ReactiveSequence>
                    <Sequence name="Phase8_回堡垒点位">
                      <PrintNode message="[Phase 8 | 2:15-1:30] 后期回到堡垒点位持续驻守"/>
                      <ReactiveSequence name="Phase8_回堡垒并维持移动姿态">
                        <MaintainSentryPosture mode="3"/>
                        <ReliableNavigateToPose goal="{goal}" goal_name="fortress" reach_threshold="{uc_fortress_hold_distance_threshold}" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                      </ReactiveSequence>
                    </Sequence>
                  </Fallback>
                </Sequence>
                <Sequence name="后期_条件大符_Phase9">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="60"/>
                  <CheckCondition key_name="ally_base_hp" comparison="gte" threshold="2000"/>
                  <Fallback name="Phase9_大符任务允许">
                    <CheckCondition key_name="large_rune_status" comparison="neq" threshold="1"/>
                  </Fallback>
                  <SetBlackboardValue key="in_rune_phase" value="1" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                  <PrintNode message="[Phase 9 | 1:30-1:00] 基地血量不低于2000，前往大符点位到点即可"/>
                  <GoalSelector goal_name="large_rune_point" goal="{goal}"/>
                  <ReactiveSequence name="Phase9_前往大符并维持移动姿态">
                    <MaintainSentryPosture mode="3"/>
                    <ReliableNavigateToPose goal="{goal}" goal_name="large_rune_point" reach_threshold="0.10" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                  </ReactiveSequence>
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <PrintNode message="[Phase 9 | 1:30-1:00] 已到达大符点位，原地等待阶段切换"/>
                  <ReactiveSequence name="Phase9_等待阶段切换并维持进攻姿态">
                    <MaintainSentryPosture mode="1"/>
                    <KeepRunningUntilFailure>
                      <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="60"/>
                    </KeepRunningUntilFailure>
                  </ReactiveSequence>
                </Sequence>
                <Sequence name="后期_守家_Phase10">
                  <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
                  <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
                  <PrintNode message="[Phase 10 | 1:00-0:00] 后期，守护基地" throttle_ms="10000"/>
                  <GoalSelector goal_name="base_defense_point" goal="{goal}"/>
                  <Fallback name="Phase10_守家维持">
                    <ReactiveSequence name="Phase10_已在守家点位半径内">
                      <CheckGoalReached goal="{goal}" threshold="0.25"/>
                      <MaintainSentryPosture mode="2"/>
                      <Wait wait_duration="0.5"/>
                    </ReactiveSequence>
                    <Sequence name="Phase10_回守家点位">
                      <RetryUntilSuccessful num_attempts="100">
                        <ReactiveSequence name="Phase10_回守家直到进驻守半径">
                          <MaintainSentryPosture mode="3"/>
                          <Sequence name="Phase10_导航并检查到点">
                            <ReliableNavigateToPose goal="{goal}" goal_name="base_defense_point" reach_threshold="0.25" resend_interval="0.30" response_timeout="0.80" result_retry_delay="0.30"/>
                            <CheckGoalReached goal="{goal}" threshold="0.25"/>
                          </Sequence>
                        </ReactiveSequence>
                      </RetryUntilSuccessful>
                    </Sequence>
                  </Fallback>
                </Sequence>
              </ReactiveFallback>
            </Parallel>
          </Sequence>
        </ReactiveFallback>
      </Sequence>
    </Fallback>
  </BehaviorTree>
  <!-- =========================
       TreeNodesModel
       ========================= -->
  <TreeNodesModel>
    <Action ID="SetSentryPosture" editable="true">
      <input_port name="mode" type="int">1:Attack, 2:Defend, 3:Move</input_port>
      <input_port name="timeout_ms" type="int">姿态切换等待超时</input_port>
      <input_port name="cooldown_ms" type="int">姿态切换冷却时间</input_port>
    </Action>
    <Action ID="MaintainSentryPosture" editable="true">
      <input_port name="mode" type="int">1:Attack, 2:Defend, 3:Move</input_port>
      <input_port name="cooldown_ms" type="int">姿态切换冷却时间</input_port>
    </Action>
    <Action ID="RequestActivateRune" editable="true">
      <input_port name="posture" type="int">请求时保持的姿态</input_port>
      <input_port name="protocol_ver" type="string">old or new</input_port>
    </Action>
    <Action ID="ConfirmResurrection" editable="true">
      <input_port name="posture"/>
      <input_port name="burst_count"/>
      <input_port name="burst_interval_ms"/>
      <input_port name="min_interval_ms"/>
    </Action>
    <Action ID="EngageRune" editable="true">
      <input_port name="rune_type"/>
      <input_port name="posture"/>
      <input_port name="timeout_ms"/>
      <input_port name="request_interval_ms"/>
    </Action>
    <Condition ID="CheckCondition" editable="true">
      <input_port name="key_name"/>
      <input_port name="comparison"/>
      <input_port name="threshold"/>
    </Condition>
    <Condition ID="CompareValues" editable="true">
      <input_port name="first_key"/>
      <input_port name="second_key"/>
      <input_port name="comparison"/>
    </Condition>
    <Action ID="GoalSelector" editable="true">
      <input_port name="goal_name"/>
      <output_port name="goal"/>
    </Action>
    <Action ID="NavigateToPose" editable="true">
      <input_port name="goal"/>
    </Action>
    <Action ID="ReliableNavigateToPose" editable="true">
      <input_port name="goal"/>
      <input_port name="goal_name"/>
      <input_port name="reach_threshold"/>
      <input_port name="resend_interval"/>
      <input_port name="response_timeout"/>
      <input_port name="result_retry_delay"/>
      <input_port name="success_condition_key"/>
      <input_port name="success_condition_comparison"/>
      <input_port name="success_condition_threshold"/>
    </Action>
    <Condition ID="CheckGoalReached" editable="true">
      <input_port name="goal"/>
      <input_port name="threshold"/>
    </Condition>
    <Action ID="PrintNode" editable="true">
      <input_port name="message"/>
      <input_port name="throttle_ms"/>
    </Action>
    <Action ID="SetBlackboardValue" editable="true">
      <input_port name="key"/>
      <input_port name="value"/>
      <input_port name="type"/>
    </Action>
    <Action ID="Wait" editable="true">
      <input_port name="wait_duration"/>
    </Action>
    <Action ID="AutoAimAndFire" editable="true">
      <input_port name="target_type"/>
    </Action>
    <Decorator ID="RetryUntilSuccessful">
      <input_port name="num_attempts"/>
    </Decorator>
    <Decorator ID="KeepRunningUntilFailure"/>
    <Decorator ID="ForceFailure"/>
    <Decorator ID="Inverter"/>
    <Control ID="Fallback"/>
    <Control ID="Parallel">
      <input_port name="success_count"/>
      <input_port name="failure_count"/>
    </Control>
    <Control ID="ReactiveSequence"/>
    <Control ID="ReactiveFallback"/>
  </TreeNodesModel>
</root>
