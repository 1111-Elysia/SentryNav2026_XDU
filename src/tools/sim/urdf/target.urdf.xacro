<?xml version="1.0"?>
<robot name="target" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="red"><color rgba="0.9 0.2 0.2 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual><geometry><box size="0.3 0.25 0.12"/></geometry><material name="red"/></visual>
    <collision><geometry><box size="0.3 0.25 0.12"/></geometry></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.02" iyy="0.03" izz="0.03" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- 4 wheels (visual only) -->
  <xacro:macro name="wheel" params="name x y">
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} -0.04" rpy="1.57 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${name}_wheel_link">
      <visual><geometry><cylinder radius="0.04" length="0.02"/></geometry><material name="dark"/></visual>
      <inertial><mass value="0.05"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
  </xacro:macro>
  <xacro:wheel name="fl" x="0.13" y="0.15"/>
  <xacro:wheel name="fr" x="0.13" y="-0.15"/>
  <xacro:wheel name="rl" x="-0.13" y="0.15"/>
  <xacro:wheel name="rr" x="-0.13" y="-0.15"/>

  <gazebo>
    <plugin name="target_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>target</namespace></ros>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>target/odom</odometry_frame>
      <robot_base_frame>target/base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_tf>true</publish_tf>
      <broadcast_tf>true</broadcast_tf>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
  <gazebo reference="base_link"><material>Gazebo/Red</material></gazebo>
</robot>
