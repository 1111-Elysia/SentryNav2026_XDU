<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="UnderAttackVw">
    <Sequence name="受击小陀螺速度控制">
      <CheckCondition key_name="is_under_attack" comparison="eq" threshold="1"/>
      <Fallback name="按血量选择小陀螺速度">
        <Sequence name="高血量受击速度">
          <CheckCondition key_name="current_hp" comparison="gte" threshold="150"/>
          <PublishVw value="1.0" republish_interval_ms="50"/>
        </Sequence>
        <Sequence name="低血量受击速度">
          <CheckCondition key_name="current_hp" comparison="lt" threshold="150"/>
          <PublishVw value="0.3" republish_interval_ms="50"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>
