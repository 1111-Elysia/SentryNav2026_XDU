<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="Root">
      <KeepRunningUntilFailure>
        <Sequence name="裁判系统连接判定">
          <Inverter>
            <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
          </Inverter>
        </Sequence>
      </KeepRunningUntilFailure>

      <ForceFailure>
        <Fallback name="裁判系统连接成功日志">
          <CheckCondition key_name="game_status_connected_logged" comparison="eq" threshold="1"/>
          <Sequence name="首次裁判系统连接成功">
            <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
            <PrintNode message="[UC] 裁判系统已连接，等待比赛开始"/>
            <SetBlackboardValue key="game_status_connected_logged" value="1" type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>

      <KeepRunningUntilFailure>
        <Sequence name="开始比赛检测">
          <CheckCondition key_name="game_progress" comparison="lte" threshold="3"/>
          <Fallback name="标记局内状态待初始化">
            <CheckCondition key_name="uc_initialized" comparison="eq" threshold="0"/>
            <Sequence name="清除局内初始化标记">
              <PrintNode message="[UC] 比赛未开始，标记局内状态待初始化"/>
              <SetBlackboardValue key="uc_initialized" value="0" type="int"/>
            </Sequence>
          </Fallback>
          <Fallback name="赛前准备阶段">
            <SubTree
              ID="PrestartInitReturn"
              prestart_message="[UC] 准备时间，持续发送 init(0,0) 导航目标"
              _autoremap="1"/>
            <CheckCondition key_name="game_progress" comparison="lte" threshold="3"/>
          </Fallback>
        </Sequence>
      </KeepRunningUntilFailure>

      <ForceFailure>
        <Fallback name="初始化">
          <CheckCondition key_name="uc_initialized" comparison="eq" threshold="1"/>
          <Sequence name="初始化状态">
            <PrintNode message="[UC] 比赛开始，初始化局内状态"/>
            <PublishScanMode enabled="false"/>
            <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
            <SetBlackboardValue key="uc_supply_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_outpost_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_highland_hold_active" value="0" type="int"/>
            <SetBlackboardValue key="uc_normal_posture" value="2" type="int"/>
            <SetBlackboardValue key="uc_fortress_goal_name" value="myhero" type="string"/>
            <SetBlackboardValue key="uc_initialized" value="1" type="int"/>
          </Sequence>
        </Fallback>
      </ForceFailure>

      <ReactiveSequence name="主循环_Root">
        <Sequence name="前置检查">
          <CheckCondition key_name="game_status_received" comparison="eq" threshold="1"/>
          <CheckCondition key_name="game_progress" comparison="eq" threshold="4"/>
        </Sequence>

        <ForceSuccess>
          <SubTree ID="UnderAttackVw" _autoremap="1"/>
        </ForceSuccess>

        <ReactiveFallback name="主逻辑_MainLogic">
          <SubTree ID="Resurrection" _autoremap="1"/>

          <SubTree
            ID="ShooterPowerRecovery"
            recovery_done_message="[回补] 发射机构电源输出恢复，继续执行全场策略"
            _autoremap="1"/>

          <SubTree
            ID="SupplyReturn"
            supply_done_message="[回补] 血量已满且允许发弹量不低于100，退出回补状态"
            _autoremap="1"/>

          <ReactiveSequence name="作战模式">
            <CheckCondition key_name="uc_supply_active" comparison="eq" threshold="0"/>
            <CheckCondition key_name="current_hp" comparison="gte" threshold="150"/>
            <Fallback name="普通姿态目标选择">
              <Sequence name="17mm热量维持_切进攻姿态">
                <CheckCondition key_name="shooter_17mm_heat_firing" comparison="eq" threshold="1"/>
                <SetBlackboardValue key="uc_normal_posture" value="1" type="int"/>
              </Sequence>
              <SetBlackboardValue key="uc_normal_posture" value="2" type="int"/>
            </Fallback>

            <ReactiveFallback name="全场策略机">
                <Sequence name="前期_小符_Phase1">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="390"/>
                  <SubTree ID="RuneTaskViaPoint" _autoremap="1"/>
                </Sequence>

                <Sequence name="前期_小符补打优先_Phase1Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="330"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="small"
                    rune_start_message="[Phase 1 Carry | 6:30-5:30] 若小符仍可进入激活窗口，优先补打小能量机关"
                    rune_arrived_message="[Phase 1 Carry | 6:30-5:30] 到达小符点位，准备继续激活小能量机关"
                    rune_done_message="[Phase 1 Carry | 6:30-5:30] 小能量机关补打流程结束"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="前期_前哨站_Phase2">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="330"/>
                  <SubTree ID="OutpostTask" _autoremap="1"/>
                </Sequence>

                <Sequence name="前期_小符_Phase3">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="300"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="small"
                    rune_start_message="[Phase 3 | 5:30-5:00] 再次前往小符点位，尝试激活小能量机关"
                    rune_arrived_message="[Phase 3 | 5:30-5:00] 到达小符点位，准备请求小能量机关"
                    rune_done_message="[Phase 3 | 5:30-5:00] 小能量机关流程结束"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="前期_小符补打优先_Phase3Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="240"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="small"
                    rune_start_message="[Phase 3 Carry | 5:00-4:00] 若小符仍可进入激活窗口，优先补打小能量机关"
                    rune_arrived_message="[Phase 3 Carry | 5:00-4:00] 到达小符点位，准备继续激活小能量机关"
                    rune_done_message="[Phase 3 Carry | 5:00-4:00] 小能量机关补打流程结束"
                    _autoremap="1"/>
                </Sequence>

                <ReactiveSequence name="中期_myhero驻守_Phase4">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="240"/>
                  <ReactiveFallback name="Phase4_英雄或云台手触发梯形高地驻守优先">
                    <SubTree
                      ID="ConditionalTrapezoidHighlandHold"
                      highland_hold_window_id="4"
                      highland_hold_trigger_message="[Phase 4] 英雄驻留梯形高地或收到本时间窗0x0303，切换至trapezoid_highland驻守"
                      _autoremap="1"/>
                    <SubTree
                      ID="MyHeroHold"
                      point_hold_message="[Phase 4 | 5:00-4:00] 不需要打符，前往 myhero 点位持续驻守"
                      _autoremap="1"/>
                  </ReactiveFallback>
                </ReactiveSequence>

                <Sequence name="中期_大符_Phase5">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="210"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_start_message="[Phase 5 | 4:00-3:30] 前往大符点位，准备激活大能量机关"
                    rune_arrived_message="[Phase 5 | 4:00-3:30] 到达大符点位，准备请求大能量机关"
                    rune_done_message="[Phase 5 | 4:00-3:30] 大能量机关流程结束"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="中期_大符补打优先_Phase5Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="165"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_start_message="[Phase 5 Carry | 3:30-2:45] 若大符仍可进入激活窗口，优先补打大能量机关"
                    rune_arrived_message="[Phase 5 Carry | 3:30-2:45] 到达大符点位，准备继续激活大能量机关"
                    rune_done_message="[Phase 5 Carry | 3:30-2:45] 大能量机关补打流程结束"
                    _autoremap="1"/>
                </Sequence>

                <ReactiveSequence name="中期_myhero驻守_Phase6">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="165"/>
                  <ReactiveFallback name="Phase6_英雄或云台手触发梯形高地驻守优先">
                    <SubTree
                      ID="ConditionalTrapezoidHighlandHold"
                      highland_hold_window_id="6"
                      highland_hold_trigger_message="[Phase 6] 英雄驻留梯形高地或收到本时间窗0x0303，切换至trapezoid_highland驻守"
                      _autoremap="1"/>
                    <SubTree
                      ID="MyHeroHold"
                      point_hold_message="[Phase 6 | 3:30-2:45] 前往 myhero 点位并进入驻守"
                      _autoremap="1"/>
                  </ReactiveFallback>
                </ReactiveSequence>

                <Sequence name="中期_大符_Phase7">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="135"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_start_message="[Phase 7 | 2:45-2:15] 再次前往大符点位，尝试激活大能量机关"
                    rune_arrived_message="[Phase 7 | 2:45-2:15] 到达大符点位，准备请求大能量机关"
                    rune_done_message="[Phase 7 | 2:45-2:15] 大能量机关流程结束"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="中期_大符补打优先_Phase7Carry">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="90"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_start_message="[Phase 7 Carry | 2:15-1:30] 若大符仍可进入激活窗口，优先补打大能量机关"
                    rune_arrived_message="[Phase 7 Carry | 2:15-1:30] 到达大符点位，准备继续激活大能量机关"
                    rune_done_message="[Phase 7 Carry | 2:15-1:30] 大能量机关补打流程结束"
                    _autoremap="1"/>
                </Sequence>

                <ReactiveSequence name="后期_myhero驻守_Phase8">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="90"/>
                  <ReactiveFallback name="Phase8_英雄或云台手触发梯形高地驻守优先">
                    <SubTree
                      ID="ConditionalTrapezoidHighlandHold"
                      highland_hold_window_id="8"
                      highland_hold_trigger_message="[Phase 8] 英雄驻留梯形高地或收到本时间窗0x0303，切换至trapezoid_highland驻守"
                      _autoremap="1"/>
                    <SubTree
                      ID="MyHeroHold"
                      point_hold_message="[Phase 8 | 2:15-1:30] 后期回到 myhero 点位持续驻守"
                      _autoremap="1"/>
                  </ReactiveFallback>
                </ReactiveSequence>

                <Sequence name="后期_大符_Phase9">
                  <CheckCondition key_name="stage_remain_time" comparison="gt" threshold="60"/>
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_start_message="[Phase 9 | 1:30-1:00] 前往大符点位，尝试激活大能量机关"
                    rune_arrived_message="[Phase 9 | 1:30-1:00] 到达大符点位，准备请求大能量机关"
                    rune_done_message="[Phase 9 | 1:30-1:00] 大能量机关流程结束"
                    _autoremap="1"/>
                </Sequence>

                <Sequence name="后期_大符补打优先_Phase9Carry">
                  <SubTree
                    ID="RuneTask"
                    rune_type="large"
                    rune_start_message="[Phase 9 Carry | 1:00-结束] 若大符仍可进入激活窗口，优先补打大能量机关"
                    rune_arrived_message="[Phase 9 Carry | 1:00-结束] 到达大符点位，准备继续激活大能量机关"
                    rune_done_message="[Phase 9 Carry | 1:00-结束] 大能量机关补打流程结束"
                    _autoremap="1"/>
                </Sequence>

                <ReactiveSequence name="全局_myhero驻守">
                  <ReactiveFallback name="Phase10_英雄或云台手触发梯形高地驻守优先">
                    <SubTree
                      ID="ConditionalTrapezoidHighlandHold"
                      highland_hold_window_id="10"
                      highland_hold_trigger_message="[Phase 10 | 1:00-结束] 英雄驻留梯形高地或收到本时间窗0x0303，切换至trapezoid_highland驻守"
                      _autoremap="1"/>
                    <SubTree
                      ID="MyHeroHold"
                      point_hold_message="[Fallback] 不需要打符，回 myhero 点位持续驻守"
                      _autoremap="1"/>
                  </ReactiveFallback>
                </ReactiveSequence>
            </ReactiveFallback>
          </ReactiveSequence>
        </ReactiveFallback>
      </ReactiveSequence>
    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="MaintainSentryPosture" editable="true">
      <input_port name="mode" type="int">1:Attack, 2:Defend, 3:Move, 4:EnhancedAttack, 5:EnhancedDefend, 6:EnhancedMove</input_port>
      <input_port name="cooldown_ms" type="int">姿态切换冷却时间</input_port>
      <input_port name="force" type="bool">忽略姿态切换冷却</input_port>
    </Action>
    <Action ID="ResolveSentryPosture" editable="true">
      <input_port name="requested_mode" type="int">请求姿态</input_port>
      <output_port name="resolved_mode" type="int">强化窗口耗尽后的实际目标姿态</output_port>
    </Action>
    <Action ID="ConfirmResurrection" editable="true">
      <input_port name="posture"/>
      <input_port name="burst_count"/>
      <input_port name="burst_interval_ms"/>
      <input_port name="min_interval_ms"/>
    </Action>
    <Action ID="BuySentryProjectile" editable="true">
      <input_port name="target_allowance"/>
      <input_port name="max_exchange_projectile"/>
      <input_port name="reserve_gold"/>
      <input_port name="buy_step"/>
      <input_port name="min_interval_ms"/>
      <input_port name="posture"/>
      <input_port name="response_timeout_ms"/>
    </Action>
    <Action ID="EngageRune" editable="true">
      <input_port name="rune_type"/>
      <input_port name="posture"/>
      <input_port name="timeout_ms"/>
      <input_port name="request_interval_ms"/>
    </Action>
    <Action ID="EngageOutpost" editable="true">
      <input_port name="timeout_ms"/>
    </Action>
    <Condition ID="CheckCondition" editable="true">
      <input_port name="key_name"/>
      <input_port name="comparison"/>
      <input_port name="threshold"/>
    </Condition>
    <Condition ID="CompareValues" editable="true">
      <input_port name="first_key"/>
      <input_port name="second_key"/>
      <input_port name="comparison"/>
    </Condition>
    <Action ID="GoalSelector" editable="true">
      <input_port name="goal_name"/>
      <output_port name="goal"/>
    </Action>
    <Action ID="RandomSelector" editable="true">
      <input_port name="goal_names"/>
      <input_port name="avoid_repeat"/>
      <output_port name="goal"/>
      <output_port name="goal_name"/>
    </Action>
    <Action ID="PatrolGoalSelector" editable="true">
      <input_port name="goal_names"/>
      <input_port name="index_key"/>
      <output_port name="goal"/>
      <output_port name="goal_name"/>
    </Action>
    <Action ID="ReliableNavigateToPose" editable="true">
      <input_port name="goal"/>
      <input_port name="goal_name"/>
      <input_port name="reach_threshold"/>
      <input_port name="resend_interval"/>
      <input_port name="response_timeout"/>
      <input_port name="result_retry_delay"/>
      <input_port name="cancel_confirm_timeout"/>
      <input_port name="log_throttle_ms"/>
      <input_port name="success_condition_key"/>
      <input_port name="success_condition_comparison"/>
      <input_port name="success_condition_threshold"/>
    </Action>
    <Condition ID="CheckGoalReached" editable="true">
      <input_port name="goal"/>
      <input_port name="threshold"/>
    </Condition>
    <Action ID="PrintNode" editable="true">
      <input_port name="message"/>
      <input_port name="throttle_ms"/>
    </Action>
    <Action ID="SetBlackboardValue" editable="true">
      <input_port name="key"/>
      <input_port name="value"/>
      <input_port name="type"/>
    </Action>
    <Action ID="Wait" editable="true">
      <input_port name="wait_duration"/>
    </Action>
    <Decorator ID="RetryUntilSuccessful">
      <input_port name="num_attempts"/>
    </Decorator>
    <Decorator ID="KeepRunningUntilFailure"/>
    <Decorator ID="ForceFailure"/>
    <Decorator ID="Inverter"/>
    <Control ID="Sequence"/>
    <Control ID="Fallback"/>
    <Control ID="Parallel">
      <input_port name="success_count"/>
      <input_port name="failure_count"/>
    </Control>
    <Control ID="ReactiveSequence"/>
    <Control ID="ReactiveFallback"/>
  </TreeNodesModel>
</root>
