<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="AdaptiveTrainingShuttle">
    <Sequence name="高地堡垒往返训练">
      <SetBlackboardValue key="in_rune_phase" value="0" type="int"/>
      <SetBlackboardValue key="uc_fortress_hold_active" value="0" type="int"/>

      <SubTree
        ID="PointHold"
        point_hold_goal_name="trapezoid_highland"
        point_hold_arrive_threshold="0.25"
        point_hold_exit_threshold="0.30"
        point_hold_move_posture="3"
        point_hold_posture="1"
        point_hold_wait_duration="{uc_adaptive_stay_duration}"
        point_hold_log_throttle_ms="2000"
        point_hold_message="{shuttle_highland_message}"
        rune_phase_key="in_rune_phase"
        fortress_active_key="uc_fortress_hold_active"
        _autoremap="true"/>

      <SubTree
        ID="PointHold"
        point_hold_goal_name="fortress"
        point_hold_arrive_threshold="0.25"
        point_hold_exit_threshold="0.30"
        point_hold_move_posture="3"
        point_hold_posture="1"
        point_hold_wait_duration="{uc_adaptive_stay_duration}"
        point_hold_log_throttle_ms="2000"
        point_hold_message="{shuttle_fortress_message}"
        rune_phase_key="in_rune_phase"
        fortress_active_key="uc_fortress_hold_active"
        _autoremap="true"/>
    </Sequence>
  </BehaviorTree>
</root>
